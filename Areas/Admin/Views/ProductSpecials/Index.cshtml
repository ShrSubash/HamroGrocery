@using HamroGrocery.Models.Entities
@using HamroGrocery.Models.ViewModels
@model HamroGrocery.Models.ViewModels.ProductSpecialsIndexViewModel
@{
    ViewData["Title"] = "Product Specials";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        background: white;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(155, 89, 182, 0.1);
        position: relative;
        overflow: hidden;
    }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
        }

        .page-header h2 {
            color: #2c3e50;
            font-weight: 700;
            margin: 0;
            font-size: 1.8rem;
        }

    .stats-row {
        margin-bottom: 30px;
    }

    .stat-box {
        background: white;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(155, 89, 182, 0.1);
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

        .stat-box:hover {
            transform: translateY(-3px);
        }

        .stat-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

        .stat-box.total::before {
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
        }

        .stat-box.active::before {
            background: linear-gradient(45deg, #27ae60, #2ecc71);
        }

        .stat-box.featured::before {
            background: linear-gradient(45deg, #f39c12, #e67e22);
        }

        .stat-box.value::before {
            background: linear-gradient(45deg, #e74c3c, #c0392b);
        }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .stat-box.total .stat-number {
        color: #9b59b6;
    }

    .stat-box.active .stat-number {
        color: #27ae60;
    }

    .stat-box.featured .stat-number {
        color: #f39c12;
    }

    .stat-box.value .stat-number {
        color: #e74c3c;
    }

    .stat-label {
        color: #7f8c8d;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .content-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(155, 89, 182, 0.1);
        overflow: hidden;
        position: relative;
    }

        .content-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
        }

    .card-header {
        padding: 20px 25px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        background: rgba(155, 89, 182, 0.02);
    }

    .table {
        margin: 0;
    }

        .table thead th {
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
            color: white;
            border: none;
            font-weight: 600;
            padding: 15px;
            font-size: 0.9rem;
        }

        .table tbody tr {
            transition: all 0.3s ease;
        }

            .table tbody tr:hover {
                background: rgba(155, 89, 182, 0.05);
                transform: translateX(5px);
            }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

    .special-name {
        font-weight: 600;
        color: #2c3e50;
        font-size: 1rem;
    }

    .special-price {
        font-weight: 700;
        color: #9b59b6;
        font-size: 1.1rem;
    }

    .original-price {
        text-decoration: line-through;
        color: #7f8c8d;
        font-size: 0.9rem;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .discount-percentage {
        background: linear-gradient(45deg, #9b59b6, #8e44ad) !important;
    }

    .discount-fixed {
        background: linear-gradient(45deg, #3498db, #2980b9) !important;
    }

    .discount-bogo {
        background: linear-gradient(45deg, #27ae60, #2ecc71) !important;
    }

    .discount-b2go {
        background: linear-gradient(45deg, #f39c12, #e67e22) !important;
    }

    .status-active {
        background: linear-gradient(45deg, #27ae60, #2ecc71) !important;
    }

    .status-inactive {
        background: linear-gradient(45deg, #95a5a6, #7f8c8d) !important;
    }

    .status-expired {
        background: linear-gradient(45deg, #e74c3c, #c0392b) !important;
    }

    .btn-group {
        display: flex;
        gap: 5px;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 0.8rem;
        border-radius: 6px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-outline-info:hover {
        background: #3498db;
        transform: translateY(-1px);
    }

    .btn-outline-warning:hover {
        background: #f39c12;
        transform: translateY(-1px);
    }

    .btn-outline-success:hover {
        background: #27ae60;
        transform: translateY(-1px);
    }

    .btn-outline-danger:hover {
        background: #e74c3c;
        transform: translateY(-1px);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #7f8c8d;
    }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.5;
            color: #9b59b6;
        }

        .empty-state h4 {
            margin-bottom: 15px;
            color: #2c3e50;
        }

    .action-buttons {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .filter-section {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .special-image {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 8px;
        border: 2px solid #e9ecef;
    }

    .featured-star {
        color: #f39c12;
        margin-left: 5px;
    }

    .date-range {
        font-size: 0.85rem;
    }

    .date-active {
        color: #27ae60;
    }

    .date-upcoming {
        color: #3498db;
    }

    .date-expired {
        color: #e74c3c;
    }

    @@media (max-width: 768px) {
        .table-responsive

    {
        font-size: 0.85rem;
    }

    .btn-sm {
        padding: 4px 8px;
        font-size: 0.7rem;
    }

    .stats-row .col-md-3 {
        margin-bottom: 15px;
    }

    .action-buttons {
        flex-direction: column;
    }

        .action-buttons .btn {
            width: 100%;
        }

    }
</style>

<!-- Success Message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <h2><i class="fas fa-tags me-2" style="color: #9b59b6;"></i>Product Specials Management</h2>
        <div class="action-buttons">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create Special
            </a>
            <button class="btn btn-success" onclick="showBulkUploadModal()">
                <i class="fas fa-upload me-2"></i>Bulk Upload
            </button>
            <button class="btn btn-info" onclick="downloadTemplate()">
                <i class="fas fa-download me-2"></i>Download Template
            </button>
        </div>
    </div>
</div>

<!-- Statistics Row -->
<div class="stats-row">
    <div class="row g-4">
        <div class="col-md-3">
            <div class="stat-box total">
                <div class="stat-number">@Model.TotalSpecials</div>
                <div class="stat-label">Total Specials</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box active">
                <div class="stat-number">@Model.ActiveSpecials</div>
                <div class="stat-label">Active Specials</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box featured">
                <div class="stat-number">@Model.FeaturedSpecials</div>
                <div class="stat-label">Featured Specials</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box value">
                <div class="stat-number">AUD @Model.TotalDiscountValue.ToString("N0")</div>
                <div class="stat-label">Total Savings</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="filter-section">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <select class="form-select" id="statusFilter">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
                <option value="expired">Expired</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Discount Type</label>
            <select class="form-select" id="discountTypeFilter">
                <option value="">All Types</option>
                <option value="Percentage">Percentage</option>
                <option value="FixedAmount">Fixed Amount</option>
                <option value="BuyOneGetOne">BOGO</option>
                <option value="BuyTwoGetOne">B2GO</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Featured</label>
            <select class="form-select" id="featuredFilter">
                <option value="">All</option>
                <option value="true">Featured</option>
                <option value="false">Not Featured</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" id="startDateFilter">
        </div>
        <div class="col-md-2">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" id="endDateFilter">
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" onclick="applyFilters()">
                <i class="fas fa-filter me-2"></i>Filter
            </button>
        </div>
    </div>
</div>

<!-- Product Specials Table -->
<div class="content-card">
    <div class="card-header">
        <h4 class="mb-0" style="color: #2c3e50; font-weight: 600;">
            <i class="fas fa-list me-2" style="color: #9b59b6;"></i>Product Specials List
        </h4>
    </div>

    @if (Model.ProductSpecials.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover" id="specialsTable">
                <thead>
                    <tr>
                        <th><i class="fas fa-image me-2"></i>Image</th>
                        <th><i class="fas fa-tag me-2"></i>Special</th>
                        <th><i class="fas fa-box me-2"></i>Product</th>
                        <th><i class="fas fa-percent me-2"></i>Discount</th>
                        <th><i class="fas fa-dollar-sign me-2"></i>Pricing</th>
                        <th><i class="fas fa-calendar me-2"></i>Duration</th>
                        <th><i class="fas fa-toggle-on me-2"></i>Status</th>
                        <th><i class="fas fa-cogs me-2"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ProductSpecials)
                    {
                        var isActive = item.IsActive && item.StartDate <= DateTime.Now && item.EndDate >= DateTime.Now;
                        var isUpcoming = item.IsActive && item.StartDate > DateTime.Now;
                        var isExpired = item.EndDate < DateTime.Now;

                        <tr data-status="@(isActive ? "active" : isExpired ? "expired" : "inactive")"
                            data-discount-type="@item.DiscountType"
                            data-featured="@item.IsFeatured.ToString().ToLower()"
                            data-start-date="@item.StartDate.ToString("yyyy-MM-dd")"
                            data-end-date="@item.EndDate.ToString("yyyy-MM-dd")">
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" class="special-image" alt="Special Image" />
                                }
                                else if (!string.IsNullOrEmpty(item.Product?.ImagePath))
                                {
                                    <img src="@item.Product.ImagePath" class="special-image" alt="Product Image" />
                                }
                                else
                                {
                                    <div class="special-image d-flex align-items-center justify-content-center bg-light">
                                        <i class="fas fa-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="special-name">
                                    @item.SpecialName
                                    @if (item.IsFeatured)
                                    {
                                        <i class="fas fa-star featured-star" title="Featured"></i>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <small class="text-muted">@item.Description.Substring(0, Math.Min(50, item.Description.Length))...</small>
                                }
                            </td>
                            <td>
                                <strong>@item.Product.ProductName</strong>
                                <br><small class="text-muted">@(item.Product.Category?.CategoryName ?? "Uncategorized")</small>
                            </td>
                            <td>
                                <span class="badge discount-@item.DiscountType.ToString().ToLower()">
                                    @if (item.DiscountType == DiscountType.Percentage)
                                    {
                                        @($"{item.DiscountValue}% OFF")
                                    }
                                    else if (item.DiscountType == DiscountType.FixedAmount)
                                    {
                                        @($"AUD {item.DiscountValue} OFF")
                                    }
                                    else
                                    {
                                        @item.DiscountType.ToString()
                                    }
                                </span>
                                @if (item.MinimumQuantity.HasValue)
                                {
                                    <br>
                        
                                    <small class="text-muted">Min Qty: @item.MinimumQuantity</small>
                                }
                            </td>
                            <td>
                                @{
                                    var discountedPrice = item.DiscountType == DiscountType.Percentage
                                    ? item.Product.Price * (1 - item.DiscountValue / 100)
                                    : item.Product.Price - item.DiscountValue;
                                    if (discountedPrice < 0) discountedPrice = 0;
                                }
                                <div class="special-price">AUD @discountedPrice.ToString("N2")</div>
                                <div class="original-price">AUD @item.Product.Price.ToString("N2")</div>
                                <small class="text-success">Save AUD @((item.Product.Price - discountedPrice).ToString("N2"))</small>
                            </td>
                            <td>
                                <div class="date-range @(isActive ? "date-active" : isUpcoming ? "date-upcoming" : "date-expired")">
                                    <strong>@item.StartDate.ToString("MMM dd")</strong> to <strong>@item.EndDate.ToString("MMM dd, yyyy")</strong>
                                    <br>
                                    @if (isActive)
                                    {
                                        <small class="text-success">Active</small>
                                    }
                                    else if (isUpcoming)
                                    {
                                        <small class="text-info">Upcoming</small>
                                    }
                                    else
                                    {
                                        <small class="text-danger">Expired</small>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="badge status-@(item.IsActive ? "active" : "inactive")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                                @if (item.IsFeatured)
                                {
                                    <br>
                        
                                    <span class="badge bg-warning">Featured</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="toggleStatus(@item.Id, @item.IsActive.ToString().ToLower())" title="Toggle Status">
                                        <i class="fas fa-@(item.IsActive ? "toggle-on" : "toggle-off")"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-success" onclick="toggleFeatured(@item.Id, @item.IsFeatured.ToString().ToLower())" title="Toggle Featured">
                                        <i class="fas fa-star@(item.IsFeatured ? "" : "-o")"></i>
                                    </button>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this special?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-tags"></i>
            <h4>No Product Specials Found</h4>
            <p>Start by creating your first product special or upload specials in bulk.</p>
            <div class="d-flex justify-content-center gap-3 mt-3">
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus me-2"></i>Create Special
                </a>
                <button class="btn btn-success btn-lg" onclick="showBulkUploadModal()">
                    <i class="fas fa-upload me-2"></i>Bulk Upload
                </button>
            </div>
        </div>
    }
</div>

<!-- Bulk Upload Modal -->
<div class="modal fade" id="bulkUploadModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Upload Product Specials</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="bulkUploadForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">CSV File</label>
                        <input type="file" class="form-control" name="csvFile" accept=".csv" required>
                        <small class="text-muted">Upload a CSV file with product specials. Download the template for the correct format.</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Default Start Date</label>
                                <input type="date" class="form-control" name="defaultStartDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Default End Date</label>
                                <input type="date" class="form-control" name="defaultEndDate" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Default Discount Type</label>
                                <select class="form-select" name="defaultDiscountType">
                                    <option value="Percentage">Percentage</option>
                                    <option value="FixedAmount">Fixed Amount</option>
                                    <option value="BuyOneGetOne">Buy One Get One</option>
                                    <option value="BuyTwoGetOne">Buy Two Get One</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Options</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="autoActivate" checked>
                                    <label class="form-check-label">Auto Activate</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="makeFeatured">
                                    <label class="form-check-label">Make Featured</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <h6>CSV Format Instructions:</h6>
                        <ul class="mb-0">
                            <li><strong>ProductName:</strong> Exact product name (required)</li>
                            <li><strong>SpecialName:</strong> Name for the special (required)</li>
                            <li><strong>DiscountValue:</strong> Discount amount/percentage (required)</li>
                            <li><strong>DiscountType:</strong> Percentage, FixedAmount, BuyOneGetOne, or BuyTwoGetOne (optional)</li>
                            <li><strong>Description:</strong> Special description (optional)</li>
                            <li><strong>StartDate:</strong> YYYY-MM-DD format (optional, uses default)</li>
                            <li><strong>EndDate:</strong> YYYY-MM-DD format (optional, uses default)</li>
                            <li><strong>MinimumQuantity:</strong> Minimum quantity required (optional)</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-upload me-2"></i>Upload Specials
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                function toggleStatus(specialId, currentStatus) {
                    if (confirm(`Are you sure you want to ${currentStatus ? 'deactivate' : 'activate'} this special?`)) {
                        fetch(`/Admin/ProductSpecials/ToggleStatus/${specialId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                location.reload();
                            } else {
                                alert('Error: ' + data.message);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('An error occurred while updating the special status.');
                        });
                    }
                }

                function toggleFeatured(specialId, currentFeatured) {
                    fetch(`/Admin/ProductSpecials/ToggleFeatured/${specialId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('An error occurred while updating the featured status.');
                    });
                }

                function showBulkUploadModal() {
                    const modal = new bootstrap.Modal(document.getElementById('bulkUploadModal'));
                    modal.show();
                }

                function downloadTemplate() {
                    const csvContent = `ProductName,SpecialName,DiscountValue,DiscountType,Description,StartDate,EndDate,MinimumQuantity
        Rice 25kg,Rice Special Offer,15,Percentage,Special discount on rice,2024-01-01,2024-01-31,1
        Milk 1L,Milk BOGO,0,BuyOneGetOne,Buy one get one free on milk,2024-01-01,2024-01-15,2
        Sugar 1kg,Sugar Discount,50,FixedAmount,Fixed discount on sugar,2024-01-01,2024-01-20,1`;

                    const blob = new Blob([csvContent], { type: 'text/csv' });
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'product_specials_template.csv';
                    a.click();
                    window.URL.revokeObjectURL(url);
                }

                function applyFilters() {
                    const statusFilter = document.getElementById('statusFilter').value;
                    const discountTypeFilter = document.getElementById('discountTypeFilter').value;
                    const featuredFilter = document.getElementById('featuredFilter').value;
                    const startDateFilter = document.getElementById('startDateFilter').value;
                    const endDateFilter = document.getElementById('endDateFilter').value;

                    const rows = document.querySelectorAll('#specialsTable tbody tr');

                    rows.forEach(row => {
                        let showRow = true;

                        if (statusFilter && row.dataset.status !== statusFilter) showRow = false;
                        if (discountTypeFilter && row.dataset.discountType !== discountTypeFilter) showRow = false;
                        if (featuredFilter && row.dataset.featured !== featuredFilter) showRow = false;
                        if (startDateFilter && row.dataset.startDate < startDateFilter) showRow = false;
                        if (endDateFilter && row.dataset.endDate > endDateFilter) showRow = false;

                        row.style.display = showRow ? '' : 'none';
                    });
                }

                // Handle bulk upload form submission
                document.getElementById('bulkUploadForm').addEventListener('submit', function(e) {
                    e.preventDefault();

                    const formData = new FormData(this);

                    fetch('/Admin/ProductSpecials/BulkUpload', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(`Successfully uploaded ${data.successCount} specials. ${data.errorCount} errors.`);
                            location.reload();
                        } else {
                            alert('Error: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('An error occurred during upload.');
                    });
                });

                // Add animation to table rows
                document.addEventListener('DOMContentLoaded', function() {
                    const rows = document.querySelectorAll('tbody tr');
                    rows.forEach((row, index) => {
                        row.style.opacity = '0';
                        row.style.transform = 'translateY(20px)';
                        setTimeout(() => {
                            row.style.transition = 'all 0.5s ease';
                            row.style.opacity = '1';
                            row.style.transform = 'translateY(0)';
                        }, index * 50);
                    });
                });
    </script>
}