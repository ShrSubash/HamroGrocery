@model IEnumerable<HamroGrocery.Models.Entities.Order>
@{
    ViewData["Title"] = "Order Management";
}

<div class="row">
    <div class="col-12">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Orders</h2>
                <div>
                    <a href="#" class="btn btn-outline-primary btn-sm me-2">
                        <i class="fas fa-filter"></i> Filter
                    </a>
                    <a href="#" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> New Order
                    </a>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>@(order.Customer?.UserName ?? "Guest")</td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td><strong>AUD @order.TotalAmount.ToString("N2")</strong></td>
                                    <td>
                                        <span class="badge bg-@(order.Status == HamroGrocery.Models.Entities.OrderStatus.Delivered ? "success" :
                                                                                                            order.Status == HamroGrocery.Models.Entities.OrderStatus.Pending ? "warning" :
                                                                                                            order.Status == HamroGrocery.Models.Entities.OrderStatus.Processing ? "info" : "secondary")">
                                    @order.Status
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = order.Id })" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i>
                                </a>
                                
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No orders found</h4>
                    <p class="text-muted">Orders will appear here when customers place them.</p>
                </div>
            }
        </div>
    </div>
</div>