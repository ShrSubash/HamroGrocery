@model HamroGrocery.Models.ViewModels.PurchaseOrderIndexViewModel
@using HamroGrocery.Models.Entities

@{
    ViewData["Title"] = "Purchase Orders";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        background: white;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(52, 152, 219, 0.1);
        position: relative;
        overflow: hidden;
    }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(45deg, #3498db, #2980b9);
        }

        .page-header h2 {
            color: #2c3e50;
            font-weight: 700;
            margin: 0;
            font-size: 1.8rem;
        }

    .stats-row {
        margin-bottom: 30px;
    }

    .stat-box {
        background: white;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(52, 152, 219, 0.1);
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

        .stat-box:hover {
            transform: translateY(-3px);
        }

        .stat-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

        .stat-box.total::before {
            background: linear-gradient(45deg, #3498db, #2980b9);
        }

        .stat-box.pending::before {
            background: linear-gradient(45deg, #f39c12, #e67e22);
        }

        .stat-box.completed::before {
            background: linear-gradient(45deg, #27ae60, #2ecc71);
        }

        .stat-box.value::before {
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
        }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .stat-box.total .stat-number {
        color: #3498db;
    }

    .stat-box.pending .stat-number {
        color: #f39c12;
    }

    .stat-box.completed .stat-number {
        color: #27ae60;
    }

    .stat-box.value .stat-number {
        color: #9b59b6;
    }

    .stat-label {
        color: #7f8c8d;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .content-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(52, 152, 219, 0.1);
        overflow: hidden;
        position: relative;
    }

        .content-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(45deg, #3498db, #2980b9);
        }

    .card-header {
        padding: 20px 25px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        background: rgba(52, 152, 219, 0.02);
    }

    .table {
        margin: 0;
    }

        .table thead th {
            background: linear-gradient(45deg, #3498db, #2980b9);
            color: white;
            border: none;
            font-weight: 600;
            padding: 15px;
            font-size: 0.9rem;
        }

        .table tbody tr {
            transition: all 0.3s ease;
        }

            .table tbody tr:hover {
                background: rgba(52, 152, 219, 0.05);
                transform: translateX(5px);
            }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

    .po-number {
        font-weight: 600;
        color: #2c3e50;
        font-size: 1rem;
    }

    .po-amount {
        font-weight: 700;
        color: #3498db;
        font-size: 1.1rem;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .status-draft {
        background: linear-gradient(45deg, #95a5a6, #7f8c8d) !important;
    }

    .status-pending {
        background: linear-gradient(45deg, #f39c12, #e67e22) !important;
    }

    .status-approved {
        background: linear-gradient(45deg, #3498db, #2980b9) !important;
    }

    .status-completed {
        background: linear-gradient(45deg, #27ae60, #2ecc71) !important;
    }

    .status-cancelled {
        background: linear-gradient(45deg, #e74c3c, #c0392b) !important;
    }

    .btn-group {
        display: flex;
        gap: 5px;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 0.8rem;
        border-radius: 6px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-outline-info:hover {
        background: #3498db;
        transform: translateY(-1px);
    }

    .btn-outline-warning:hover {
        background: #f39c12;
        transform: translateY(-1px);
    }

    .btn-outline-success:hover {
        background: #27ae60;
        transform: translateY(-1px);
    }

    .btn-outline-danger:hover {
        background: #e74c3c;
        transform: translateY(-1px);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #7f8c8d;
    }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.5;
            color: #3498db;
        }

        .empty-state h4 {
            margin-bottom: 15px;
            color: #2c3e50;
        }

    .action-buttons {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .filter-section {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    @@media (max-width: 768px) {
        .table-responsive

    {
        font-size: 0.85rem;
    }

    .btn-sm {
        padding: 4px 8px;
        font-size: 0.7rem;
    }

    .stats-row .col-md-3 {
        margin-bottom: 15px;
    }

    .action-buttons {
        flex-direction: column;
    }

        .action-buttons .btn {
            width: 100%;
        }

    }
</style>

<!-- Success Message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <h2><i class="fas fa-shopping-cart me-2" style="color: #3498db;"></i>Purchase Orders Management</h2>
        <div class="action-buttons">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create Purchase Order
            </a>
            <a asp-action="CreateProduct" class="btn btn-success">
                <i class="fas fa-box me-2"></i>Add New Product
            </a>
        </div>
    </div>
</div>

<!-- Statistics Row -->
<div class="stats-row">
    <div class="row g-4">
        <div class="col-md-3">
            <div class="stat-box total">
                <div class="stat-number">@Model.TotalOrders</div>
                <div class="stat-label">Total Orders</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box pending">
                <div class="stat-number">@Model.PendingOrders</div>
                <div class="stat-label">Pending Orders</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box completed">
                <div class="stat-number">@Model.CompletedOrders</div>
                <div class="stat-label">Completed Orders</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box value">
                <div class="stat-number">AUD @Model.TotalValue.ToString("N0")</div>
                <div class="stat-label">Total Value</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="filter-section">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Status Filter</label>
            <select class="form-select" id="statusFilter">
                <option value="">All Status</option>
                <option value="Draft">Draft</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Date Range</label>
            <input type="date" class="form-control" id="dateFrom">
        </div>
        <div class="col-md-3">
            <label class="form-label">&nbsp;</label>
            <input type="date" class="form-control" id="dateTo">
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-primary w-100" onclick="applyFilters()">
                <i class="fas fa-filter me-2"></i>Apply Filters
            </button>
        </div>
    </div>
</div>

<!-- Purchase Orders Table -->
<div class="content-card">
    <div class="card-header">
        <h4 class="mb-0" style="color: #2c3e50; font-weight: 600;">
            <i class="fas fa-list me-2" style="color: #3498db;"></i>Purchase Orders List
        </h4>
    </div>

    @if (Model.PurchaseOrders.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover" id="purchaseOrdersTable">
                <thead>
                    <tr>
                        <th><i class="fas fa-hashtag me-2"></i>PO Number</th>
                        <th><i class="fas fa-truck me-2"></i>Supplier</th>
                        <th><i class="fas fa-calendar me-2"></i>Order Date</th>
                        <th><i class="fas fa-boxes me-2"></i>Items</th>
                        <th><i class="fas fa-dollar-sign me-2"></i>Total Amount</th>
                        <th><i class="fas fa-flag me-2"></i>Status</th>
                        <th><i class="fas fa-clock me-2"></i>Created</th>
                        <th><i class="fas fa-cogs me-2"></i>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PurchaseOrders)
                    {
                        <tr data-status="@item.Status" data-date="@item.OrderDate.ToString("yyyy-MM-dd")">
                            <td>
                                <div class="po-number">@item.PONumber</div>
                                @if (item.IsAutoGenerated)
                                {
                                    <small class="text-muted"><i class="fas fa-robot me-1"></i>Auto-generated</small>
                                }
                            </td>
                            <td>
                                <strong>@(item.Supplier?.SupplierName ?? "No Supplier")</strong>
                                @if (!string.IsNullOrEmpty(item.Supplier?.ContactPerson))
                                {
                                    <br>
                                    <small class="text-muted">@item.Supplier.ContactPerson</small>
                                }
                            </td>
                            <td>
                                <strong>@item.OrderDate.ToString("MMM dd, yyyy")</strong>
                                @if (item.ExpectedDeliveryDate.HasValue)
                                {
                                    <br>
                                    <small class="text-muted">Expected: @item.ExpectedDeliveryDate.Value.ToString("MMM dd")</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-info">@item.Items.Count item(s)</span>
                                @if (item.Items.Any())
                                {
                                    <br>
                                    <small class="text-muted">Qty: @item.Items.Sum(i => i.Quantity)</small>
                                }
                            </td>
                            <td>
                                <span class="po-amount">AUD @item.TotalAmount.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="badge status-@item.Status.ToString().ToLower()">@item.Status</span>
                            </td>
                            <td>
                                <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</small>
                                @if (item.UpdatedAt.HasValue)
                                {
                                    <br>
                                    <small class="text-muted">Updated: @item.UpdatedAt.Value.ToString("MMM dd")</small>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (item.Status == PurchaseOrderStatus.Draft)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                    @if (item.Status == PurchaseOrderStatus.Draft)
                                    {
                                        <button class="btn btn-sm btn-outline-success" onclick="updateStatus(@item.Id, 'Pending')" title="Submit for Approval">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    }
                                    @if (item.Status == PurchaseOrderStatus.Pending)
                                    {
                                        <button class="btn btn-sm btn-outline-success" onclick="updateStatus(@item.Id, 'Approved')" title="Approve">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                    @if (item.Status == PurchaseOrderStatus.Approved)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="receivePurchaseOrder(@item.Id)" title="Receive Order">
                                            <i class="fas fa-truck-loading"></i>
                                        </button>
                                    }
                                    @if (item.Status != PurchaseOrderStatus.Completed && item.Status != PurchaseOrderStatus.Cancelled)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" onclick="updateStatus(@item.Id, 'Cancelled')" title="Cancel">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-shopping-cart"></i>
            <h4>No Purchase Orders Found</h4>
            <p>Start by creating your first purchase order or add products to your inventory.</p>
            <div class="d-flex justify-content-center gap-3 mt-3">
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus me-2"></i>Create Purchase Order
                </a>
                <a asp-action="CreateProduct" class="btn btn-success btn-lg">
                    <i class="fas fa-box me-2"></i>Add Product
                </a>
            </div>
        </div>
    }
</div>

<!-- Receive Purchase Order Modal -->
<div class="modal fade" id="receivePOModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Receive Purchase Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="receiveOrderContent">
                    <!-- Content will be loaded dynamically -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="confirmReceiveOrder()">Confirm Receipt</button>
            </div>
        </div>
    </div>
</div>

<!-- Anti-forgery token -->
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        let currentPOId = null;

        function updateStatus(poId, newStatus) {
            const statusMessages = {
                'Pending': 'submit this purchase order for approval',
                'Approved': 'approve this purchase order',
                'Cancelled': 'cancel this purchase order'
            };

            if (confirm(`Are you sure you want to ${statusMessages[newStatus] || 'update the status of this purchase order'}?`)) {
                fetch(`/Admin/PurchaseOrders/UpdateStatus/${poId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(newStatus)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while updating the status.');
                });
            }
        }

        function receivePurchaseOrder(poId) {
            currentPOId = poId;

            // Load purchase order details for receiving
            fetch(`/Admin/PurchaseOrders/Details/${poId}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('receiveOrderContent').innerHTML = `
                        <p>Loading purchase order items...</p>
                        <div id="receiveItems"></div>
                    `;

                    const modal = new bootstrap.Modal(document.getElementById('receivePOModal'));
                    modal.show();

                    // Simulate loading items (replace with actual API call)
                    setTimeout(() => {
                        loadReceiveOrderItems(poId);
                    }, 500);
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error loading purchase order details.');
                });
        }

        function loadReceiveOrderItems(poId) {
            // This would be replaced with an actual API endpoint
            const sampleItems = `
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Ordered Qty</th>
                                <th>Received Qty</th>
                            </tr>
                        </thead>
                        <tbody id="receiveItemsBody">
                            <!-- Items would be loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            `;

            document.getElementById('receiveOrderContent').innerHTML = sampleItems;
        }

        function confirmReceiveOrder() {
            if (!currentPOId) return;

            // Collect received quantities
            const receivedItems = [];
            // Implementation would collect actual data from the form

            fetch(`/Admin/PurchaseOrders/ReceivePurchaseOrder/${currentPOId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ ReceivedItems: receivedItems })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('receivePOModal'));
                    modal.hide();
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while receiving the order.');
            });
        }

        function applyFilters() {
            const statusFilter = document.getElementById('statusFilter').value;
            const dateFrom = document.getElementById('dateFrom').value;
            const dateTo = document.getElementById('dateTo').value;

            const rows = document.querySelectorAll('#purchaseOrdersTable tbody tr');

            rows.forEach(row => {
                let showRow = true;

                // Status filter
                if (statusFilter && row.dataset.status !== statusFilter) {
                    showRow = false;
                }

                // Date range filter
                if (dateFrom || dateTo) {
                    const rowDate = row.dataset.date;
                    if (dateFrom && rowDate < dateFrom) showRow = false;
                    if (dateTo && rowDate > dateTo) showRow = false;
                }

                row.style.display = showRow ? '' : 'none';
            });
        }

        // Add animation to table rows
        document.addEventListener('DOMContentLoaded', function() {
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach((row, index) => {
                row.style.opacity = '0';
                row.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    row.style.transition = 'all 0.5s ease';
                    row.style.opacity = '1';
                    row.style.transform = 'translateY(0)';
                }, index * 50);
            });
        });
    </script>
}