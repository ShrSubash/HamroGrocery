@model HamroGrocery.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="dashboard modern-dashboard">
    <!-- Welcome Section -->
    <div class="welcome-section animate-fade-in">
        <div class="welcome-content">
            <div class="greeting-badge">
                <i class="fas fa-sparkles"></i>
                <span>@DateTime.Now.ToString("dddd")</span>
            </div>
            <h1>Welcome back, @(User.Identity?.Name?.Split('@')[0] ?? "Admin")!</h1>
            <p>Here's your store performance overview</p>
            <div class="quick-metrics">
                <div class="quick-metric-item">
                    <i class="fas fa-calendar-day"></i>
                    <span>@DateTime.Now.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="quick-metric-item highlight">
                    <i class="fas fa-dollar-sign"></i>
                    <span>Today: <strong>AUD @Model.TodaysSales.ToString("N2")</strong></span>
                </div>
            </div>
        </div>
        <div class="welcome-illustration">
            <i class="fas fa-chart-line"></i>
        </div>
    </div>

    <!-- Enhanced Key Metrics -->
    <div class="stats-grid">
        <div class="stat-card primary-card animate-slide-up" style="animation-delay: 0.1s;">
            <div class="stat-header">
                <div class="stat-icon primary">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="stat-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>@Model.SalesGrowthPercentage%</span>
                </div>
            </div>
            <div class="stat-body">
                <span class="stat-label">Total Sales</span>
                <h3 class="stat-value">AUD @Model.TotalSales.ToString("N2")</h3>
                <p class="stat-meta">
                    <span class="badge-soft success">This Month</span>
                    <span class="stat-subtext">Avg: AUD @Model.AverageOrderValue.ToString("N2")</span>
                </p>
            </div>
        </div>

        <div class="stat-card success-card animate-slide-up" style="animation-delay: 0.2s;">
            <div class="stat-header">
                <div class="stat-icon success">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="stat-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>@Model.OrdersGrowthPercentage%</span>
                </div>
            </div>
            <div class="stat-body">
                <span class="stat-label">Total Orders</span>
                <h3 class="stat-value">@Model.TotalOrders</h3>
                <p class="stat-meta">
                    <span class="badge-soft success">This Week</span>
                    <span class="stat-subtext">Weekly: AUD @Model.WeeklySales.ToString("N2")</span>
                </p>
            </div>
        </div>

        <div class="stat-card warning-card animate-slide-up" style="animation-delay: 0.3s;">
            <div class="stat-header">
                <div class="stat-icon warning">
                    <i class="fas fa-box"></i>
                </div>
                <div class="stat-trend @(Model.LowStockCount > 0 ? "negative" : "neutral")">
                    <i class="fas @(Model.LowStockCount > 0 ? "fa-exclamation-triangle" : "fa-check")"></i>
                    <span>@Model.LowStockCount</span>
                </div>
            </div>
            <div class="stat-body">
                <span class="stat-label">Active Products</span>
                <h3 class="stat-value">@Model.ActiveProducts</h3>
                <p class="stat-meta">
                    <span class="badge-soft warning">Low Stock</span>
                    <span class="stat-subtext">@Model.OutOfStockCount out of stock</span>
                </p>
            </div>
        </div>

        <div class="stat-card info-card animate-slide-up" style="animation-delay: 0.4s;">
            <div class="stat-header">
                <div class="stat-icon info">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-trend positive">
                    <i class="fas fa-arrow-up"></i>
                    <span>@Model.CustomersGrowthPercentage%</span>
                </div>
            </div>
            <div class="stat-body">
                <span class="stat-label">Total Customers</span>
                <h3 class="stat-value">@Model.TotalCustomers</h3>
                <p class="stat-meta">
                    <span class="badge-soft info">Active</span>
                    <span class="stat-subtext">@Model.TotalCategories categories</span>
                </p>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-4 mb-4">
        <!-- Main Sales Chart -->
        <div class="col-lg-8">
            <div class="content-card chart-card">
                <div class="card-header-modern">
                    <div class="header-left">
                        <h5 class="card-title">
                            <i class="fas fa-chart-area"></i>
                            Sales & Revenue Analytics
                        </h5>
                        <p class="card-subtitle">Track your performance trends</p>
                    </div>
                    <div class="chart-filters">
                        <div class="filter-group">
                            <label>Period</label>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-filter period-btn active" data-period="7days">7D</button>
                                <button type="button" class="btn btn-filter period-btn" data-period="30days">30D</button>
                                <button type="button" class="btn btn-filter period-btn" data-period="90days">90D</button>
                                <button type="button" class="btn btn-filter period-btn" data-period="365days">1Y</button>
                            </div>
                        </div>
                        <div class="filter-group">
                            <label>Group By</label>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-filter group-btn active" data-group="day">Day</button>
                                <button type="button" class="btn btn-filter group-btn" data-group="week">Week</button>
                                <button type="button" class="btn btn-filter group-btn" data-group="month">Month</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chart Summary Stats -->
                <div class="chart-summary">
                    <div class="summary-item">
                        <span class="summary-label">Total Revenue</span>
                        <h4 id="chartTotalRevenue" class="summary-value">AUD @Model.TotalSales.ToString("N2")</h4>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Orders</span>
                        <h4 id="chartTotalOrders" class="summary-value">@Model.TotalOrders</h4>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Avg Order</span>
                        <h4 id="chartAvgOrder" class="summary-value">AUD @Model.AverageOrderValue.ToString("N2")</h4>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Change</span>
                        <h4 id="chartComparison" class="summary-value text-success">
                            <i class="fas fa-arrow-up"></i> +@Model.SalesGrowthPercentage%
                        </h4>
                    </div>
                </div>

                <div class="chart-wrapper">
                    <canvas id="mainSalesChart"></canvas>
                </div>

                <div class="chart-loading d-none">
                    <div class="spinner-border" role="status"></div>
                    <p>Updating data...</p>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <!-- Orders Status Donut -->
            <div class="content-card chart-card mb-4">
                <div class="card-header-modern">
                    <h5 class="card-title">
                        <i class="fas fa-chart-pie"></i>
                        Orders by Status
                    </h5>
                </div>
                <div class="chart-wrapper-small">
                    <canvas id="ordersStatusChart"></canvas>
                </div>
                <div class="status-legend">
                    @foreach (var status in Model.OrdersByStatus)
                    {
                        <div class="legend-item">
                            <span class="legend-dot" style="background-color: @GetStatusColor(status.Key)"></span>
                            <span class="legend-label">@status.Key</span>
                            <span class="legend-value">@status.Value</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Stats Card -->
            <div class="content-card">
                <div class="card-header-modern">
                    <h5 class="card-title">
                        <i class="fas fa-bolt"></i>
                        Quick Stats
                    </h5>
                </div>
                <div class="quick-stats-list">
                    <div class="quick-stat-row">
                        <div class="stat-icon-wrapper primary">
                            <i class="fas fa-calendar-week"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-name">This Week</span>
                            <strong class="stat-amount">AUD @Model.WeeklySales.ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="quick-stat-row">
                        <div class="stat-icon-wrapper success">
                            <i class="fas fa-calendar-day"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-name">Today</span>
                            <strong class="stat-amount">AUD @Model.TodaysSales.ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="quick-stat-row">
                        <div class="stat-icon-wrapper info">
                            <i class="fas fa-shopping-bag"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-name">Avg Order Value</span>
                            <strong class="stat-amount">AUD @Model.AverageOrderValue.ToString("N2")</strong>
                        </div>
                    </div>
                    <div class="quick-stat-row">
                        <div class="stat-icon-wrapper danger">
                            <i class="fas fa-box-open"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-name">Out of Stock</span>
                            <strong class="stat-amount">@Model.OutOfStockCount items</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders and Alerts Row -->
    <div class="row g-4 mb-4">
        <!-- Recent Orders -->
        <div class="col-lg-8">
            <div class="content-card">
                <div class="card-header-modern">
                    <div class="header-left">
                        <h5 class="card-title">
                            <i class="fas fa-receipt"></i>
                            Recent Orders
                        </h5>
                        <p class="card-subtitle">Latest delivered orders</p>
                    </div>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        View All <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
                @if (Model.RecentOrders.Any())
                {
                    <div class="table-responsive">
                        <table class="table modern-table">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.RecentOrders.Take(8))
                                {
                                    <tr>
                                        <td>
                                            <div class="order-info">
                                                <strong class="order-number">@o.OrderNumber</strong>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="customer-cell">
                                                <div class="customer-avatar">@o.CustomerInitials</div>
                                                <span class="customer-name">@o.CustomerName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="date-cell">
                                                <span class="date-main">@o.OrderDate.ToString("dd MMM")</span>
                                                <span class="date-time">@o.OrderDate.ToString("hh:mm tt")</span>
                                            </div>
                                        </td>
                                        <td><span class="badge badge-success">@o.Status</span></td>
                                        <td><strong class="amount">AUD @o.TotalAmount.ToString("N2")</strong></td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId"
                                               class="btn btn-sm btn-action" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-shopping-cart"></i>
                        <p>No orders yet</p>
                    </div>
                }
            </div>
        </div>

        <!-- Alerts & Actions -->
        <div class="col-lg-4">
            <!-- Alerts -->
            <div class="content-card mb-4">
                <div class="card-header-modern">
                    <h5 class="card-title">
                        <i class="fas fa-bell"></i>
                        Alerts
                    </h5>
                </div>
                <div class="alerts-container">
                    @foreach (var alert in Model.Alerts)
                    {
                        var alertClass = alert.Type.ToLower() switch
                        {
                            "danger" => "alert-danger",
                            "warning" => "alert-warning",
                            "info" => "alert-info",
                            "success" => "alert-success",
                            _ => "alert-info"
                        };

                        if (alert.Title.Contains("Low Stock") || alert.Title.Contains("Out of Stock"))
                        {
                            <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="alert-box @alertClass">
                                <div class="alert-icon">
                                    <i class="@alert.Icon"></i>
                                </div>
                                <div class="alert-content">
                                    <strong class="alert-title">@alert.Title</strong>
                                    <p class="alert-desc">@alert.Description</p>
                                </div>
                                <i class="fas fa-chevron-right alert-arrow"></i>
                            </a>
                        }
                        else if (alert.Title.Contains("Pending") || alert.Title.Contains("Processing"))
                        {
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="alert-box @alertClass">
                                <div class="alert-icon">
                                    <i class="@alert.Icon"></i>
                                </div>
                                <div class="alert-content">
                                    <strong class="alert-title">@alert.Title</strong>
                                    <p class="alert-desc">@alert.Description</p>
                                </div>
                                <i class="fas fa-chevron-right alert-arrow"></i>
                            </a>
                        }
                        else
                        {
                            <div class="alert-box @alertClass">
                                <div class="alert-icon">
                                    <i class="@alert.Icon"></i>
                                </div>
                                <div class="alert-content">
                                    <strong class="alert-title">@alert.Title</strong>
                                    <p class="alert-desc">@alert.Description</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="content-card">
                <div class="card-header-modern">
                    <h5 class="card-title">
                        <i class="fas fa-zap"></i>
                        Quick Actions
                    </h5>
                </div>
                <div class="quick-actions">
                    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="action-btn primary">
                        <i class="fas fa-plus-circle"></i>
                        <span>Add Product</span>
                    </a>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="action-btn success">
                        <i class="fas fa-list-ul"></i>
                        <span>Manage Orders</span>
                    </a>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="action-btn info">
                        <i class="fas fa-tags"></i>
                        <span>Categories</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Selling Products -->
    <div class="content-card">
        <div class="card-header-modern">
            <div class="header-left">
                <h5 class="card-title">
                    <i class="fas fa-fire"></i>
                    Top Selling Products
                </h5>
                <p class="card-subtitle">Best performers this month</p>
            </div>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-primary">
                View All <i class="fas fa-arrow-right"></i>
            </a>
        </div>
        @if (Model.TopProducts.Any())
        {
            <div class="products-grid">
                @foreach (var p in Model.TopProducts.Take(5))
                {
                    <div class="product-card-compact">
                        <div class="product-image-wrapper">
                            <img src="@p.ImageUrl" alt="@p.ProductName" class="product-image"
                                 onerror="this.src='https://via.placeholder.com/60x60/f0f0f0/999999?text=No+Image'" />
                            <span class="badge @p.StockBadgeClass stock-badge">@p.StockStatus</span>
                        </div>
                        <div class="product-details">
                            <h6 class="product-name">@p.ProductName</h6>
                            <span class="product-category">@p.CategoryName</span>
                        </div>
                        <div class="product-metrics">
                            <div class="metric-item">
                                <i class="fas fa-box"></i>
                                <span>@p.UnitsSold sold</span>
                            </div>
                            <div class="metric-item revenue">
                                <i class="fas fa-dollar-sign"></i>
                                <strong>AUD @p.Revenue.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-box"></i>
                <p>No sales data available</p>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let mainChart;
        let currentPeriod = '7days';
        let currentGroupBy = 'day';

        document.addEventListener('DOMContentLoaded', function() {
            initializeMainChart();
            initializeOrdersStatusChart();
            attachFilterListeners();
        });

        function initializeMainChart() {
            const ctx = document.getElementById('mainSalesChart');

            mainChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.MonthlySalesData.Keys.Select(k => $"\"{k}\"")))],
                    datasets: [{
                        label: 'Sales (AUD)',
                        data: [@Html.Raw(string.Join(",", Model.MonthlySalesData.Values))],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointHoverBackgroundColor: '#059669',
                        pointHoverBorderColor: '#fff',
                        pointHoverBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(17, 24, 39, 0.95)',
                            padding: 12,
                            titleFont: { size: 13, weight: '600' },
                            bodyFont: { size: 14 },
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return 'Revenue: AUD ' + context.parsed.y.toLocaleString('en-US', {minimumFractionDigits: 2});
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.04)',
                                drawBorder: false
                            },
                            ticks: {
                                callback: function(value) {
                                    return 'AUD ' + value.toLocaleString();
                                },
                                font: { size: 11 },
                                color: '#6b7280'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: { size: 11 },
                                color: '#6b7280',
                                maxRotation: 0
                            }
                        }
                    }
                }
            });
        }

        function initializeOrdersStatusChart() {
            const ctx = document.getElementById('ordersStatusChart');

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.OrdersByStatus.Keys.Select(k => $"\"{k}\"")))],
                    datasets: [{
                        data: [@Html.Raw(string.Join(",", Model.OrdersByStatus.Values))],
                        backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6'],
                        borderWidth: 0,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(17, 24, 39, 0.95)',
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(context) {
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((context.parsed / total) * 100).toFixed(1);
                                    return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }

        function attachFilterListeners() {
            document.querySelectorAll('.period-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentPeriod = this.dataset.period;
                    updateChartData();
                });
            });

            document.querySelectorAll('.group-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.group-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentGroupBy = this.dataset.group;
                    updateChartData();
                });
            });
        }

        async function updateChartData() {
            try {
                showLoading(true);
                const response = await fetch(`/Admin/Home/GetChartData?period=${currentPeriod}&groupBy=${currentGroupBy}`);
                const data = await response.json();

                mainChart.data.labels = Object.keys(data.salesData);
                mainChart.data.datasets[0].data = Object.values(data.salesData);
                mainChart.update('active');

                updateChartStats(data);
                showLoading(false);
            } catch (error) {
                console.error('Error updating chart:', error);
                showLoading(false);
            }
        }

        function updateChartStats(data) {
            document.getElementById('chartTotalRevenue').textContent = 'AUD ' + data.totalRevenue.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('chartTotalOrders').textContent = data.totalOrders.toLocaleString();
            document.getElementById('chartAvgOrder').textContent = 'AUD ' + data.averageOrderValue.toLocaleString('en-US', {minimumFractionDigits: 2});

            const comparisonEl = document.getElementById('chartComparison');
            const isPositive = data.comparisonPercentage >= 0;
            comparisonEl.className = isPositive ? 'summary-value text-success' : 'summary-value text-danger';
            comparisonEl.innerHTML = `<i class="fas fa-arrow-${isPositive ? 'up' : 'down'}"></i> ${isPositive ? '+' : ''}${data.comparisonPercentage}%`;
        }

        function showLoading(show) {
            const chartContainer = document.querySelector('.chart-wrapper');
            const loadingEl = document.querySelector('.chart-loading');

            if (show) {
                chartContainer.style.opacity = '0.5';
                loadingEl.classList.remove('d-none');
            } else {
                chartContainer.style.opacity = '1';
                loadingEl.classList.add('d-none');
            }
        }
    </script>
}

@functions {
    string GetStatusColor(string status)
    {
        return status switch
        {
            "Delivered" => "#10b981",
            "Processing" => "#3b82f6",
            "Pending" => "#f59e0b",
            "Cancelled" => "#ef4444",
            _ => "#8b5cf6"
        };
    }
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --primary: #10b981;
        --primary-dark: #059669;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --info: #3b82f6;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-300: #d1d5db;
        --gray-400: #9ca3af;
        --gray-500: #6b7280;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-800: #1f2937;
        --gray-900: #111827;
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
