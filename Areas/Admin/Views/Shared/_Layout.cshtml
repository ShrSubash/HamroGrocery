@*
  Hamro Grocery Admin - Full-Width Shopify-Inspired Layout
  File: Areas/Admin/Views/Shared/_Layout.cshtml
*@
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hamro Grocery Admin</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom Admin Styles -->
    <link rel="stylesheet" href="~/css/admin-modern.css?v=@DateTime.Now.Ticks" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Mobile Sidebar Toggle Button -->
    <button id="sidebarToggle" aria-label="Toggle Sidebar">
        <i class="fas fa-bars"></i>
    </button>

    <div class="admin-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <!-- Brand Logo -->
            <div class="brand">
                <i class="fas fa-basket-shopping me-2"></i>
                <span>Hamro Admin</span>
            </div>

            <!-- Main Navigation -->
            <nav class="nav flex-column mt-4">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-gauge"></i>
                    <span>Dashboard</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="fas fa-cart-shopping"></i>
                    <span>Orders</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"
                   asp-area="Admin" asp-controller="Products" asp-action="Index">
                    <i class="fas fa-box"></i>
                    <span>Products</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                   asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="fas fa-tags"></i>
                    <span>Categories</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                   asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="fas fa-users"></i>
                    <span>Users</span> <!-- Changed from "Customers" -->
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")"
                   asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                    <i class="fas fa-warehouse"></i>
                    <span>Inventory</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcements" ? "active" : "")"
                   asp-area="Admin" asp-controller="Announcements" asp-action="Index">
                    <i class="fas fa-bullhorn"></i>
                    <span>Announcements</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analytics" ? "active" : "")"
                   asp-area="Admin" asp-controller="Analytics" asp-action="Index">
                    <i class="fas fa-chart-line"></i>
                    <span>Analytics</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                   asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <i class="fas fa-file-lines"></i>
                    <span>Reports</span>
                </a>
            </nav>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                <button id="themeToggle" class="theme-toggle" title="Toggle Theme">
                    <i class="fas fa-moon"></i>
                </button>
                <a href="/" target="_blank" class="store-link" title="View Store">
                    <i class="fas fa-store"></i>
                </a>
            </div>
        </aside>

        <!-- Main Content Panel -->
        <div class="main-panel">
            <!-- Top Navigation Bar -->
            <header class="topbar">
                <h1 class="page-title">@ViewData["Title"]</h1>

                <div class="user-area dropdown">
                    <button class="user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <span class="user-name d-none d-sm-inline">
                            @(User.Identity?.Name?.Split('@')[0] ?? "User")
                        </span>
                        <i class="fas fa-chevron-down ms-2"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li class="dropdown-item-text text-muted px-3">
                            <small>@User.Identity?.Name</small>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                <i class="fas fa-user me-2"></i>Profile Settings
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/" target="_blank">
                                <i class="fas fa-store me-2"></i>View Store
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="content-area">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer">
                &copy; @DateTime.Now.Year Hamro Grocery. All rights reserved. | Powered by ASP.NET Core
            </footer>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom Admin Scripts -->
    <script src="~/js/admin-modern.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>