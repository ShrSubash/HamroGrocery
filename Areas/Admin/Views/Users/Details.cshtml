@model HamroGrocery.Models.Entities.User
@{
    ViewData["Title"] = $"User Details - {Model.FullName}";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .details-page {
        padding-bottom: 50px;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #6c757d;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 20px;
        transition: color 0.2s;
    }

        .back-button:hover {
            color: #e74c3c;
        }

    .user-profile-card {
        background: white;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #e9ecef;
        margin-bottom: 30px;
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 30px;
        padding-bottom: 30px;
        border-bottom: 2px solid #f8f9fa;
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 3rem;
        font-weight: 700;
        box-shadow: 0 8px 24px rgba(231, 76, 60, 0.3);
        flex-shrink: 0;
    }

    .profile-info h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
    }

    .profile-meta {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

        .profile-meta .meta-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #6c757d;
        }

    .info-section {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #e9ecef;
        margin-bottom: 24px;
    }

        .info-section h3 {
            font-size: 1.3rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f8f9fa;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .info-item .label {
            font-size: 0.85rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .info-item .value {
            font-size: 1rem;
            color: #2c3e50;
            font-weight: 500;
        }

    .badge {
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .stat-box {
        background: #f8f9fa;
        padding: 24px;
        border-radius: 12px;
        text-align: center;
        border: 2px solid #e9ecef;
    }

        .stat-box .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
            display: block;
            margin-bottom: 8px;
        }

        .stat-box .stat-label {
            font-size: 0.85rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .btn-group-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }
</style>

<div class="details-page">
    <div class="container-fluid">
        <!-- Back Button -->
        <a asp-action="Index" class="back-button">
            <i class="fas fa-arrow-left"></i>
            <span>Back to Users</span>
        </a>

        <!-- Profile Card -->
        <div class="user-profile-card">
            <div class="profile-header">
                <div class="profile-avatar">
                    @{
                        if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">
                        }
                        else
                        {
                            var name = Model.FullName ?? Model.Email ?? "User";
                            var initial = !string.IsNullOrWhiteSpace(name) ? name.Trim()[0].ToString().ToUpper() : "U";
                            @initial
                        }
                    }
                </div>

                <div class="profile-info flex-grow-1">
                    <h1>@Model.FullName</h1>
                    <div class="profile-meta">
                        <div class="meta-item">
                            <i class="fas fa-envelope"></i>
                            <span>@Model.Email</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <div class="meta-item">
                                <i class="fas fa-phone"></i>
                                <span>@Model.PhoneNumber</span>
                            </div>
                        }
                        <div class="meta-item">
                            <i class="fas fa-calendar"></i>
                            <span>Joined @Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <span class="badge tier-@Model.MembershipTier.ToString().ToLower()">
                            <i class="fas fa-crown me-1"></i>@Model.MembershipTier
                        </span>
                        <span class="badge bg-@(Model.Role == UserRole.SuperAdmin ? "danger" : Model.Role == UserRole.Admin ? "warning" : "secondary")">
                            @Model.Role
                        </span>
                        <span class="badge bg-@(Model.IsActive ? "success" : "danger")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Statistics -->
            <div class="stats-grid">
                <div class="stat-box">
                    <span class="stat-value">@Model.TotalPurchases</span>
                    <span class="stat-label">Total Orders</span>
                </div>
                <div class="stat-box">
                    <span class="stat-value">AUD @Model.TotalSpent.ToString("N2")</span>
                    <span class="stat-label">Total Spent</span>
                </div>
                <div class="stat-box">
                    <span class="stat-value">@Model.LoyaltyPoints</span>
                    <span class="stat-label">Loyalty Points</span>
                </div>
                <div class="stat-box">
                    <span class="stat-value">@Model.ReviewCount</span>
                    <span class="stat-label">Reviews</span>
                </div>
                <div class="stat-box">
                    <span class="stat-value">@Model.ComplaintCount</span>
                    <span class="stat-label">Complaints</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="btn-group-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-edit me-2"></i>Edit User
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </div>

        <div class="row">
            <!-- Personal Information -->
            <div class="col-md-6">
                <div class="info-section">
                    <h3><i class="fas fa-user me-2"></i>Personal Information</h3>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="label">First Name</span>
                            <span class="value">@Model.FirstName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.MiddleName))
                        {
                            <div class="info-item">
                                <span class="label">Middle Name</span>
                                <span class="value">@Model.MiddleName</span>
                            </div>
                        }
                        <div class="info-item">
                            <span class="label">Last Name</span>
                            <span class="value">@Model.LastName</span>
                        </div>
                        @if (Model.DateOfBirth.HasValue)
                        {
                            <div class="info-item">
                                <span class="label">Date of Birth</span>
                                <span class="value">@Model.DateOfBirth.Value.ToString("MMMM dd, yyyy")</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Gender))
                        {
                            <div class="info-item">
                                <span class="label">Gender</span>
                                <span class="value">@Model.Gender</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Address Information -->
            <div class="col-md-6">
                <div class="info-section">
                    <h3><i class="fas fa-map-marker-alt me-2"></i>Address Information</h3>
                    <div class="info-grid">
                        @if (!string.IsNullOrEmpty(Model.AddressLineOne))
                        {
                            <div class="info-item">
                                <span class="label">Address Line 1</span>
                                <span class="value">@Model.AddressLineOne</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.AddressLineTwo))
                        {
                            <div class="info-item">
                                <span class="label">Address Line 2</span>
                                <span class="value">@Model.AddressLineTwo</span>
                            </div>
                        }
                        @if (Model.City != null)
                        {
                            <div class="info-item">
                                <span class="label">City</span>
                                <span class="value">@Model.City.CityName</span>
                            </div>
                        }
                        @if (Model.StateProvince != null)
                        {
                            <div class="info-item">
                                <span class="label">State/Province</span>
                                <span class="value">@Model.StateProvince.StateName</span>
                            </div>
                        }
                        @if (Model.Country != null)
                        {
                            <div class="info-item">
                                <span class="label">Country</span>
                                <span class="value">@Model.Country.CountryName</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.PostalCode))
                        {
                            <div class="info-item">
                                <span class="label">Postal Code</span>
                                <span class="value">@Model.PostalCode</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Orders -->
        @if (Model.Orders.Any())
        {
            <div class="info-section">
                <h3><i class="fas fa-shopping-cart me-2"></i>Recent Orders (@Model.Orders.Count)</h3>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Order Number</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate).Take(10))
                            {
                                <tr>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-primary">@order.Status</span></td>
                                    <td><strong>AUD @order.TotalAmount.ToString("N2")</strong></td>
                                    <td>
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>