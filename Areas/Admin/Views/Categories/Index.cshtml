@model List<HamroGrocery.Models.Entities.Category>
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #10b981;
        --primary-dark: #059669;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-900: #111827;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .modern-categories {
        padding: 24px;
        background: var(--gray-50);
    }

    /* Page Header */
    .page-header {
        background: white;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: var(--shadow);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid var(--gray-200);
    }

        .page-header h2 {
            font-size: 24px;
            font-weight: 700;
            color: var(--gray-900);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .page-header h2 i {
                color: var(--primary);
            }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: var(--shadow);
        transition: all 0.3s;
        border: 1px solid var(--gray-200);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--primary-dark));
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 13px;
        color: var(--gray-600);
        font-weight: 500;
    }

    /* Content Card */
    .content-card {
        background: white;
        border-radius: 12px;
        box-shadow: var(--shadow);
        border: 1px solid var(--gray-200);
        overflow: hidden;
    }

    .card-header-modern {
        padding: 20px 24px;
        border-bottom: 1px solid var(--gray-200);
        background: var(--gray-50);
    }

        .card-header-modern h4 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--gray-900);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-header-modern h4 i {
                color: var(--primary);
            }

    /* Modern Table */
    .modern-table {
        width: 100%;
        margin: 0;
    }

        .modern-table thead th {
            background: var(--gray-50);
            color: var(--gray-700);
            border: none;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 14px 20px;
            border-bottom: 2px solid var(--gray-200);
        }

        .modern-table tbody tr {
            border-bottom: 1px solid var(--gray-100);
            transition: all 0.2s;
        }

            .modern-table tbody tr:hover {
                background: var(--gray-50);
            }

        .modern-table tbody td {
            padding: 16px 20px;
            vertical-align: middle;
        }

    .category-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .category-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .category-name {
        font-weight: 600;
        color: var(--gray-900);
        font-size: 15px;
    }

    .category-desc {
        font-size: 13px;
        color: var(--gray-600);
        max-width: 300px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Badges */
    .badge {
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .badge-success {
        background: rgba(16, 185, 129, 0.1);
        color: #047857;
    }

    .badge-secondary {
        background: rgba(107, 114, 128, 0.1);
        color: var(--gray-600);
    }

    .badge-info {
        background: rgba(59, 130, 246, 0.1);
        color: #2563eb;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 6px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border: 1px solid var(--gray-200);
        border-radius: 6px;
        background: white;
        color: var(--gray-600);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

        .action-btn:hover {
            transform: translateY(-2px);
        }

        .action-btn.view:hover {
            background: #3b82f6;
            border-color: #3b82f6;
            color: white;
        }

        .action-btn.edit:hover {
            background: var(--warning);
            border-color: var(--warning);
            color: white;
        }

        .action-btn.toggle:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }

        .action-btn.delete:hover {
            background: var(--danger);
            border-color: var(--danger);
            color: white;
        }

    /* Buttons */
    .btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
    }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
            color: white;
        }

    /* Alerts */
    .alert {
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        border: none;
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.1);
        border-left: 4px solid var(--success);
        color: #047857;
    }

    .alert-danger {
        background: rgba(239, 68, 68, 0.1);
        border-left: 4px solid var(--danger);
        color: #dc2626;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 80px 24px;
    }

    .empty-icon {
        width: 120px;
        height: 120px;
        margin: 0 auto 24px;
        background: rgba(16, 185, 129, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        color: var(--primary);
    }

    .empty-state h4 {
        font-size: 20px;
        font-weight: 600;
        color: var(--gray-900);
        margin-bottom: 8px;
    }

    .empty-state p {
        color: var(--gray-600);
        margin-bottom: 24px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .modern-categories

    {
        padding: 16px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .modern-table {
        font-size: 13px;
    }

    .action-buttons {
        flex-wrap: wrap;
    }

    }

    /* Animations */
    @@keyframes slideIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .animate-in {
        animation: slideIn 0.4s ease-out;
    }
</style>

<div class="modern-categories">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success animate-in">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger animate-in">
            <i class="fas fa-exclamation-triangle"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Page Header -->
    <div class="page-header animate-in">
        <h2>
            <i class="fas fa-tags"></i>
            Categories
        </h2>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Add Category
        </a>
    </div>

    <!-- Statistics -->
    <div class="stats-grid">
        <div class="stat-card animate-in" style="animation-delay: 0.1s;">
            <div class="stat-value">@Model.Count</div>
            <div class="stat-label">Total Categories</div>
        </div>
        <div class="stat-card animate-in" style="animation-delay: 0.2s;">
            <div class="stat-value">@Model.Count(c => c.IsActive)</div>
            <div class="stat-label">Active Categories</div>
        </div>
        <div class="stat-card animate-in" style="animation-delay: 0.3s;">
            <div class="stat-value">@Model.Count(c => !c.IsActive)</div>
            <div class="stat-label">Inactive Categories</div>
        </div>
    </div>

    <!-- Categories Table -->
    <div class="content-card animate-in" style="animation-delay: 0.4s;">
        <div class="card-header-modern">
            <h4>
                <i class="fas fa-list"></i>
                All Categories
            </h4>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Order</th>
                            <th>Products</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.OrderBy(c => c.DisplayOrder))
                        {
                            <tr>
                                <td>
                                    <div class="category-cell">
                                        <div class="category-icon">
                                            @(category.Icon ?? "🛒")
                                        </div>
                                        <div>
                                            <div class="category-name">@category.CategoryName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(category.Description))
                                    {
                                        <div class="category-desc">@category.Description</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 13px;">No description</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-info">#@category.DisplayOrder</span>
                                </td>
                                <td>
                                    <span class="badge badge-info">@(category.Products?.Count ?? 0) items</span>
                                </td>
                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check-circle"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">
                                            <i class="fas fa-times-circle"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <small style="color: var(--gray-600);">@category.CreatedAt.ToString("dd MMM yyyy")</small>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@category.Id"
                                           class="action-btn view" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@category.Id"
                                           class="action-btn edit" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="action-btn toggle"
                                                onclick="toggleStatus(@category.Id, @category.IsActive.ToString().ToLower())"
                                                title="Toggle Status">
                                            <i class="fas fa-@(category.IsActive ? "toggle-on" : "toggle-off")"></i>
                                        </button>
                                        <button class="action-btn delete"
                                                onclick="confirmDelete(@category.Id, '@category.CategoryName')"
                                                title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-tags"></i>
                </div>
                <h4>No Categories Yet</h4>
                <p>Start organizing your products by creating categories</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Add Your First Category
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleStatus(categoryId, currentStatus) {
            if (confirm(`Are you sure you want to ${currentStatus ? 'deactivate' : 'activate'} this category?`)) {
                fetch(`/Admin/Categories/ToggleStatus/${categoryId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while updating the category status.');
                });
            }
        }

        function confirmDelete(id, name) {
            if (confirm(`Are you sure you want to delete "${name}"?`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Admin/Categories/Delete/' + id;

                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    const hiddenToken = document.createElement('input');
                    hiddenToken.type = 'hidden';
                    hiddenToken.name = '__RequestVerificationToken';
                    hiddenToken.value = token.value;
                    form.appendChild(hiddenToken);
                }

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}