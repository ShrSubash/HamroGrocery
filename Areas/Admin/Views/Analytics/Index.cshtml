@model HamroGrocery.Areas.Admin.Models.ViewModels.AnalyticsDashboardViewModel
@{
    ViewData["Title"] = "Analytics Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #10b981;
        --primary-dark: #059669;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-900: #111827;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --info: #3b82f6;
        --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .modern-analytics {
        padding: 24px;
        background: var(--gray-50);
    }

    /* Page Header */
    .page-header {
        background: white;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: var(--shadow);
        border: 1px solid var(--gray-200);
    }

    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--gray-900);
        margin: 0 0 8px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .page-title i {
            color: var(--primary);
        }

    .page-subtitle {
        color: var(--gray-600);
        font-size: 14px;
        margin: 0;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: var(--shadow);
        transition: all 0.3s;
        border: 1px solid var(--gray-200);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

        .stat-card.primary::before {
            background: linear-gradient(90deg, var(--primary), var(--primary-dark));
        }

        .stat-card.info::before {
            background: linear-gradient(90deg, var(--info), #2563eb);
        }

        .stat-card.warning::before {
            background: linear-gradient(90deg, var(--warning), #d97706);
        }

        .stat-card.success::before {
            background: linear-gradient(90deg, var(--success), #047857);
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .stat-card.primary .stat-icon {
        background: rgba(16, 185, 129, 0.1);
        color: var(--primary);
    }

    .stat-card.info .stat-icon {
        background: rgba(59, 130, 246, 0.1);
        color: var(--info);
    }

    .stat-card.warning .stat-icon {
        background: rgba(245, 158, 11, 0.1);
        color: var(--warning);
    }

    .stat-card.success .stat-icon {
        background: rgba(16, 185, 129, 0.1);
        color: var(--success);
    }

    .stat-number {
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 4px;
        color: var(--gray-900);
    }

    .stat-label {
        font-size: 13px;
        color: var(--gray-600);
        font-weight: 500;
        margin-bottom: 8px;
    }

    .stat-growth {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

        .stat-growth.positive {
            background: rgba(16, 185, 129, 0.1);
            color: #047857;
        }

        .stat-growth.negative {
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
        }

    /* Content Grid */
    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 24px;
    }

    /* Cards */
    .content-card {
        background: white;
        border-radius: 12px;
        box-shadow: var(--shadow);
        border: 1px solid var(--gray-200);
        overflow: hidden;
    }

    .card-header-modern {
        padding: 20px 24px;
        border-bottom: 1px solid var(--gray-200);
        background: var(--gray-50);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .card-header-modern h4 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--gray-900);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-header-modern h4 i {
                color: var(--primary);
            }

    .card-body {
        padding: 24px;
    }

    /* Chart Container */
    .chart-container {
        position: relative;
        height: 300px;
        margin-top: 16px;
    }

    /* Top Products */
    .product-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .product-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: var(--gray-50);
        border-radius: 8px;
        border: 1px solid var(--gray-200);
        transition: all 0.2s;
    }

        .product-item:hover {
            background: white;
            border-color: var(--primary);
        }

    .product-rank {
        width: 32px;
        height: 32px;
        background: var(--primary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .product-image {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        object-fit: cover;
        background: var(--gray-200);
        flex-shrink: 0;
    }

    .product-info {
        flex: 1;
        min-width: 0;
    }

    .product-name {
        font-weight: 600;
        color: var(--gray-900);
        font-size: 14px;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .product-category {
        font-size: 12px;
        color: var(--gray-600);
    }

    .product-stats {
        text-align: right;
    }

    .product-revenue {
        font-weight: 700;
        color: var(--primary);
        font-size: 15px;
    }

    .product-quantity {
        font-size: 12px;
        color: var(--gray-600);
    }

    /* Category List */
    .category-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .category-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .category-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .category-details {
        flex: 1;
    }

    .category-name {
        font-weight: 600;
        color: var(--gray-900);
        font-size: 14px;
        margin-bottom: 4px;
    }

    .category-progress {
        height: 6px;
        background: var(--gray-200);
        border-radius: 3px;
        overflow: hidden;
    }

    .category-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, var(--primary), var(--primary-dark));
        transition: width 0.3s;
    }

    .category-revenue {
        text-align: right;
    }

    .category-amount {
        font-weight: 700;
        color: var(--gray-900);
        font-size: 15px;
    }

    .category-percentage {
        font-size: 12px;
        color: var(--gray-600);
    }

    /* Recent Orders Table */
    .orders-table {
        width: 100%;
    }

        .orders-table thead th {
            background: var(--gray-50);
            color: var(--gray-700);
            border: none;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 12px;
            border-bottom: 2px solid var(--gray-200);
        }

        .orders-table tbody tr {
            border-bottom: 1px solid var(--gray-100);
            transition: all 0.2s;
        }

            .orders-table tbody tr:hover {
                background: var(--gray-50);
            }

        .orders-table tbody td {
            padding: 12px;
            font-size: 13px;
        }

    .order-number {
        font-weight: 600;
        color: var(--primary);
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

        .status-badge.pending {
            background: rgba(245, 158, 11, 0.1);
            color: #d97706;
        }

        .status-badge.processing {
            background: rgba(59, 130, 246, 0.1);
            color: #2563eb;
        }

        .status-badge.completed {
            background: rgba(16, 185, 129, 0.1);
            color: #047857;
        }

        .status-badge.cancelled {
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
        }

    /* Alert Box */
    .alert-box {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-left: 4px solid var(--warning);
        border-radius: 8px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
    }

        .alert-box i {
            color: var(--warning);
            font-size: 20px;
        }

    .alert-content {
        flex: 1;
    }

        .alert-content h6 {
            margin: 0 0 4px 0;
            font-size: 14px;
            font-weight: 600;
            color: #996e00;
        }

        .alert-content p {
            margin: 0;
            font-size: 13px;
            color: #996e00;
        }

    /* Responsive */
    @@media (max-width: 1024px) {
        .content-grid

    {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 768px) {
        .modern-analytics

    {
        padding: 16px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    }

    /* Animations */
    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .animate-in {
        animation: fadeIn 0.4s ease-out;
    }

    /* Period Tabs */
    .period-tabs {
        display: flex;
        gap: 8px;
        background: var(--gray-100);
        padding: 4px;
        border-radius: 8px;
    }

    .period-tab {
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        background: transparent;
        color: var(--gray-700);
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }

        .period-tab.active {
            background: white;
            color: var(--primary);
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }
</style>

<div class="modern-analytics">
    <!-- Page Header -->
    <div class="page-header animate-in">
        <h1 class="page-title">
            <i class="fas fa-chart-line"></i>
            Analytics Dashboard
        </h1>
        <p class="page-subtitle">Comprehensive overview of your business performance and insights</p>
    </div>

    <!-- Inventory Alerts -->
    @if (Model.LowStockCount > 0 || Model.OutOfStockCount > 0)
    {
        <div class="alert-box animate-in" style="animation-delay: 0.1s;">
            <i class="fas fa-exclamation-triangle"></i>
            <div class="alert-content">
                <h6>Inventory Alerts</h6>
                <p>
                    @if (Model.OutOfStockCount > 0)
                    {
                        <span>@Model.OutOfStockCount products out of stock. </span>
                    }
                    @if (Model.LowStockCount > 0)
                    {
                        <span>@Model.LowStockCount products running low.</span>
                    }
                    <a href="/Admin/Inventory" style="color: #996e00; font-weight: 600; text-decoration: underline;">View Inventory →</a>
                </p>
            </div>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="stats-grid">
        <div class="stat-card primary animate-in" style="animation-delay: 0.1s;">
            <div class="stat-header">
                <div>
                    <div class="stat-number">NPR @Model.TotalRevenue.ToString("N0")</div>
                    <div class="stat-label">Total Revenue</div>
                    @if (Model.RevenueGrowth != 0)
                    {
                        <span class="stat-growth @(Model.RevenueGrowth > 0 ? "positive" : "negative")">
                            <i class="fas fa-arrow-@(Model.RevenueGrowth > 0 ? "up" : "down")"></i>
                            @Math.Abs(Model.RevenueGrowth).ToString("F1")%
                        </span>
                    }
                </div>
                <div class="stat-icon">
                    <i class="fas fa-dollar-sign"></i>
                </div>
            </div>
        </div>

        <div class="stat-card info animate-in" style="animation-delay: 0.2s;">
            <div class="stat-header">
                <div>
                    <div class="stat-number">@Model.TotalOrders</div>
                    <div class="stat-label">Total Orders</div>
                    <div style="font-size: 12px; color: var(--gray-600);">Today: @Model.TodayOrders</div>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
            </div>
        </div>

        <div class="stat-card warning animate-in" style="animation-delay: 0.3s;">
            <div class="stat-header">
                <div>
                    <div class="stat-number">NPR @Model.AverageOrderValue.ToString("N0")</div>
                    <div class="stat-label">Average Order Value</div>
                    <div style="font-size: 12px; color: var(--gray-600);">Per transaction</div>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-receipt"></i>
                </div>
            </div>
        </div>

        <div class="stat-card success animate-in" style="animation-delay: 0.4s;">
            <div class="stat-header">
                <div>
                    <div class="stat-number">@Model.TotalCustomers</div>
                    <div class="stat-label">Total Customers</div>
                    <div style="font-size: 12px; color: var(--gray-600);">New this month: @Model.NewCustomersThisMonth</div>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="content-grid">
        <!-- Sales Chart -->
        <div class="content-card animate-in" style="animation-delay: 0.5s;">
            <div class="card-header-modern">
                <h4>
                    <i class="fas fa-chart-area"></i>
                    Sales Overview
                </h4>
                <div class="period-tabs">
                    <button class="period-tab active" onclick="loadChartData('daily')">7 Days</button>
                    <button class="period-tab" onclick="loadChartData('monthly')">6 Months</button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="salesChart"></canvas>
            </div>
        </div>

        <!-- Top Categories -->
        <div class="content-card animate-in" style="animation-delay: 0.6s;">
            <div class="card-header-modern">
                <h4>
                    <i class="fas fa-tags"></i>
                    Top Categories
                </h4>
            </div>
            <div class="card-body">
                <div class="category-list">
                    @foreach (var category in Model.TopCategories)
                    {
                        <div class="category-item">
                            <div class="category-icon">
                                @(category.Icon ?? "🛒")
                            </div>
                            <div class="category-details">
                                <div class="category-name">@category.CategoryName</div>
                                <div class="category-progress">
                                    <div class="category-progress-bar" style="width: @category.Percentage%"></div>
                                </div>
                            </div>
                            <div class="category-revenue">
                                <div class="category-amount">NPR @category.Revenue.ToString("N0")</div>
                                <div class="category-percentage">@category.Percentage.ToString("F1")%</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Top Products -->
    <div class="content-card animate-in" style="animation-delay: 0.7s;">
        <div class="card-header-modern">
            <h4>
                <i class="fas fa-trophy"></i>
                Top Selling Products
            </h4>
        </div>
        <div class="card-body">
            <div class="product-list">
                @for (int i = 0; i < Model.TopSellingProducts.Count; i++)
                {
                    var product = Model.TopSellingProducts[i];
                    <div class="product-item">
                        <div class="product-rank">@(i + 1)</div>
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="@product.ProductName" class="product-image"
                                 onerror="this.src='https://via.placeholder.com/48?text=IMG'" />
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/48/f3f4f6/6b7280?text=IMG" alt="No image" class="product-image" />
                        }
                        <div class="product-info">
                            <div class="product-name">@product.ProductName</div>
                            <div class="product-category">@product.CategoryName</div>
                        </div>
                        <div class="product-stats">
                            <div class="product-revenue">NPR @product.Revenue.ToString("N0")</div>
                            <div class="product-quantity">@product.QuantitySold sold</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="content-card animate-in" style="animation-delay: 0.8s;">
        <div class="card-header-modern">
            <h4>
                <i class="fas fa-clock"></i>
                Recent Orders
            </h4>
            <a href="/Admin/Orders" style="color: var(--primary); font-size: 13px; font-weight: 600; text-decoration: none;">
                View All →
            </a>
        </div>
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Order Number</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>
                                    <span class="order-number">@order.OrderNumber</span>
                                </td>
                                <td>@order.CustomerName</td>
                                <td><strong>NPR @order.TotalAmount.ToString("N0")</strong></td>
                                <td>
                                    <span class="status-badge @order.Status.ToLower()">
                                        @order.Status
                                    </span>
                                </td>
                                <td style="color: var(--gray-600);">
                                    @order.OrderDate.ToString("MMM dd, yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        let salesChart = null;

        // Initialize chart with server data
        const initialData = {
            labels: [@Html.Raw(string.Join(",", Model.DailySales.Select(s => $"'{s.Label}'")))],
            datasets: [{
                label: 'Revenue (NPR)',
                data: [@string.Join(",", Model.DailySales.Select(s => s.Value))],
                borderColor: '#10b981',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                tension: 0.4,
                fill: true
            }]
        };

        function initChart(data) {
            const ctx = document.getElementById('salesChart');

            if (salesChart) {
                salesChart.destroy();
            }

            salesChart = new Chart(ctx, {
                type: 'line',
                data: data,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'NPR ' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'NPR ' + value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }

        // Load chart data via AJAX
        async function loadChartData(period) {
            try {
                // Update tab active state
                document.querySelectorAll('.period-tab').forEach(tab => {
                    tab.classList.remove('active');
                });
                event.target.classList.add('active');

                const response = await fetch('/Admin/Analytics/GetChartData?period=' + period);
                const data = await response.json();

                const chartData = {
                    labels: data.map(d => d.label),
                    datasets: [{
                        label: 'Revenue (NPR)',
                        data: data.map(d => d.revenue),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                };

                initChart(chartData);
            } catch (error) {
                console.error('Error loading chart data:', error);
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            initChart(initialData);
        });
    </script>
}