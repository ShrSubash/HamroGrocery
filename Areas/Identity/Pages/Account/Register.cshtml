@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;  // This prevents layout conflicts
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Hamro Grocery</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
        }

            body::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(45deg, rgba(231, 76, 60, 0.8) 0%, rgba(192, 57, 43, 0.6) 100%);
                opacity: 0.9;
                z-index: 0;
            }

        .register-container {
            max-width: 1100px;
            width: 100%;
            position: relative;
            z-index: 10;
        }

        .register-card {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
            overflow: hidden;
        }

        .register-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            padding: 50px 40px;
            text-align: center;
            color: white;
        }

            .register-header .icon {
                font-size: 60px;
                margin-bottom: 20px;
            }

            .register-header h1 {
                font-size: 2.8rem;
                font-weight: 800;
                margin-bottom: 10px;
            }

            .register-header p {
                font-size: 1.1rem;
                opacity: 0.9;
            }

        .register-body {
            padding: 50px 40px;
        }

        .form-section {
            background: rgba(15, 15, 15, 0.02);
            border-radius: 20px;
            padding: 40px;
            border: 1px solid rgba(231, 76, 60, 0.1);
        }

        .section-title {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 30px;
            color: #1f1f1f;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .section-title i {
                color: #e74c3c;
            }

        .form-floating {
            margin-bottom: 25px;
            position: relative;
        }

            .form-floating input {
                background: white;
                border: 2px solid #e9ecef;
                border-radius: 12px;
                padding: 18px 20px 18px 50px;
                height: 60px;
                width: 100%;
                font-size: 1rem;
                transition: all 0.3s ease;
            }

                .form-floating input:focus {
                    border-color: #e74c3c;
                    box-shadow: 0 0 0 0.2rem rgba(231, 76, 60, 0.25);
                    outline: none;
                }

            .form-floating label {
                position: absolute;
                top: 20px;
                left: 50px;
                color: #9ca3af;
                font-weight: 500;
                pointer-events: none;
                transition: all 0.3s ease;
            }

            .form-floating input:focus ~ label,
            .form-floating input:not(:placeholder-shown) ~ label {
                top: 5px;
                font-size: 0.75rem;
                color: #e74c3c;
            }

        .input-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 1.1rem;
            z-index: 5;
        }

        .password-toggle {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #9ca3af;
            cursor: pointer;
            font-size: 1.1rem;
            z-index: 5;
        }

            .password-toggle:hover {
                color: #e74c3c;
            }

        .btn-register {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            border-radius: 12px;
            padding: 18px 40px;
            font-size: 1.2rem;
            font-weight: 700;
            color: white;
            width: 100%;
            height: 60px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .btn-register:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 35px rgba(231, 76, 60, 0.4);
            }

        .login-link {
            text-align: center;
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #e9ecef;
        }

            .login-link a {
                color: #e74c3c;
                text-decoration: none;
                font-weight: 600;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        .text-danger {
            color: #ff6b6b;
            font-size: 0.9rem;
            margin-top: 8px;
            display: block;
        }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(231, 76, 60, 0.3), transparent);
            margin: 30px 0;
        }

        .no-external-providers {
            background: rgba(231, 76, 60, 0.05);
            border: 1px solid rgba(231, 76, 60, 0.2);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
        }

            .no-external-providers i {
                font-size: 3rem;
                color: #e74c3c;
                margin-bottom: 20px;
                display: block;
            }

            .no-external-providers h5 {
                color: #2c3e50;
                margin-bottom: 15px;
            }

            .no-external-providers .text-muted {
                color: #6c757d;
            }

        .password-strength {
            margin-top: 10px;
            display: none;
        }

        .strength-bar {
            height: 6px;
            border-radius: 3px;
            background: #e9ecef;
            margin-top: 8px;
            overflow: hidden;
        }

        .strength-fill {
            height: 100%;
            transition: all 0.3s ease;
        }

        .strength-weak {
            background: #ff6b6b;
            width: 33%;
        }

        .strength-medium {
            background: #f39c12;
            width: 66%;
        }

        .strength-strong {
            background: #27ae60;
            width: 100%;
        }

        .requirements-list {
            list-style: none;
            padding: 0;
            margin-top: 15px;
            font-size: 0.85rem;
        }

            .requirements-list li {
                padding: 5px 0;
                color: #9ca3af;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .requirements-list li i {
                    font-size: 0.75rem;
                }

                .requirements-list li.met {
                    color: #27ae60;
                }

                    .requirements-list li.met i {
                        color: #27ae60;
                    }

        @@media (max-width: 768px) {
            .register-header h1

        {
            font-size: 2rem;
        }

        .register-body {
            padding: 30px 20px;
        }

        .form-section {
            padding: 25px 20px;
        }

        .section-title {
            font-size: 1.3rem;
        }

        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card">
            <div class="register-header">
                <div class="icon"><i class="fas fa-user-plus"></i></div>
                <h1>Create Your Account</h1>
                <p>Join Hamro Grocery and start shopping fresh today!</p>
            </div>

            <div class="register-body">
                <div class="row">
                    <!-- Registration Form -->
                    <div class="col-lg-6">
                        <div class="form-section">
                            <h2 class="section-title">
                                <i class="fas fa-user-circle"></i>
                                Account Details
                            </h2>

                            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                                <div class="form-floating">
                                    <i class="fas fa-envelope input-icon"></i>
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username"
                                           placeholder="name@example.com" id="emailInput" />
                                    <label asp-for="Input.Email">Email Address</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>

                                <div class="form-floating">
                                    <i class="fas fa-lock input-icon"></i>
                                    <input asp-for="Input.Password" class="form-control" type="password"
                                           autocomplete="new-password" placeholder="password" id="passwordInput" />
                                    <label asp-for="Input.Password">Password</label>
                                    <button type="button" class="password-toggle" onclick="togglePassword('passwordInput')">
                                        <i class="fas fa-eye" id="passwordInput-icon"></i>
                                    </button>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>

                                <div class="password-strength" id="passwordStrength">
                                    <div class="strength-bar">
                                        <div class="strength-fill" id="strengthFill"></div>
                                    </div>
                                    <ul class="requirements-list">
                                        <li id="req-length"><i class="fas fa-circle"></i> At least 6 characters</li>
                                        <li id="req-digit"><i class="fas fa-circle"></i> Contains a number</li>
                                    </ul>
                                </div>

                                <div class="form-floating">
                                    <i class="fas fa-lock input-icon"></i>
                                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password"
                                           autocomplete="new-password" placeholder="password" id="confirmPasswordInput" />
                                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                                    <button type="button" class="password-toggle" onclick="togglePassword('confirmPasswordInput')">
                                        <i class="fas fa-eye" id="confirmPasswordInput-icon"></i>
                                    </button>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>

                                <button id="registerSubmit" type="submit" class="btn btn-register">
                                    <i class="fas fa-user-plus me-2"></i>Create Account
                                </button>

                                <div class="login-link">
                                    <p class="mb-0">
                                        Already have an account?
                                        <a asp-area="Identity" asp-page="/Account/Login">
                                            <i class="fas fa-sign-in-alt me-1"></i>Sign In
                                        </a>
                                    </p>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- External Login / Benefits -->
                    <div class="col-lg-6">
                        <div class="form-section">
                            <h3 class="section-title">
                                <i class="fas fa-share-alt"></i>Quick Sign Up
                            </h3>
                            <div class="divider"></div>

                            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                            {
                                <div class="no-external-providers">
                                    <i class="fas fa-info-circle"></i>
                                    <h5>Social Sign-Up Coming Soon!</h5>
                                    <p class="text-muted">We're working on adding social login options for your convenience.</p>
                                </div>
                            }
                            else
                            {
                                <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                    <div class="d-grid gap-3">
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit" class="btn btn-outline-primary"
                                                    name="provider" value="@provider.Name">
                                                Continue with @provider.DisplayName
                                            </button>
                                        }
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(inputId + '-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        const passwordInput = document.getElementById('passwordInput');
        const passwordStrength = document.getElementById('passwordStrength');
        const strengthFill = document.getElementById('strengthFill');

        if (passwordInput && passwordStrength && strengthFill) {
            passwordInput.addEventListener('input', function() {
                if (this.value.length > 0) {
                    passwordStrength.style.display = 'block';
                    const hasLength = this.value.length >= 6;
                    const hasDigit = /\d/.test(this.value);

                    const reqLength = document.getElementById('req-length');
                    const reqDigit = document.getElementById('req-digit');

                    if (reqLength) {
                        reqLength.classList.toggle('met', hasLength);
                        const lengthIcon = reqLength.querySelector('i');
                        if (lengthIcon) {
                            lengthIcon.classList.toggle('fa-circle', !hasLength);
                            lengthIcon.classList.toggle('fa-check-circle', hasLength);
                        }
                    }

                    if (reqDigit) {
                        reqDigit.classList.toggle('met', hasDigit);
                        const digitIcon = reqDigit.querySelector('i');
                        if (digitIcon) {
                            digitIcon.classList.toggle('fa-circle', !hasDigit);
                            digitIcon.classList.toggle('fa-check-circle', hasDigit);
                        }
                    }

                    strengthFill.className = 'strength-fill';
                    if (hasLength && hasDigit) {
                        strengthFill.classList.add('strength-strong');
                    } else if (hasLength || hasDigit) {
                        strengthFill.classList.add('strength-medium');
                    } else {
                        strengthFill.classList.add('strength-weak');
                    }
                } else {
                    passwordStrength.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>