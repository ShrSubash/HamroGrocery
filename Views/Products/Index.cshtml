@using HamroGrocery.Models.Entities
@model IEnumerable<Product>

@{
    ViewData["Title"] = "All Products - HamroGrocery";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var currentCategory = ViewBag.CurrentCategory as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<style>
    /* === MODERN MINIMAL DESIGN === */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #f5f7fa;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* === BREADCRUMB === */
    .breadcrumb-section {
        background: white;
        padding: 20px 0;
        border-bottom: 1px solid #e9ecef;
    }

    .breadcrumb-custom {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        color: #6c757d;
    }

        .breadcrumb-custom a {
            color: #e74c3c;
            text-decoration: none;
            transition: color 0.2s;
        }

            .breadcrumb-custom a:hover {
                color: #c0392b;
            }

        .breadcrumb-custom .separator {
            color: #dee2e6;
        }

    /* === HEADER === */
    .products-header {
        background: white;
        padding: 24px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .products-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: #2c3e50;
            margin: 0;
        }

        .products-header .subtitle {
            color: #6c757d;
            font-size: 1rem;
        }

    /* === LAYOUT === */
    .products-container {
        padding: 40px 0;
    }

    /* === SIDEBAR === */
    .sidebar {
        position: sticky;
        top: 100px;
    }

    .filter-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #e9ecef;
    }

    .filter-title {
        font-size: 0.875rem;
        font-weight: 700;
        color: #2c3e50;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 20px;
    }

    .category-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .category-list a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-radius: 10px;
            color: #495057;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.2s ease;
            background: transparent;
        }

            .category-list a:hover {
                background: #f8f9fa;
                color: #e74c3c;
                transform: translateX(2px);
            }

            .category-list a.active {
                background: linear-gradient(135deg, #e74c3c, #c0392b);
                color: white;
                font-weight: 600;
            }

                .category-list a.active .count {
                    background: rgba(255,255,255,0.2);
                    color: white;
                }

        .category-list .count {
            background: #e9ecef;
            color: #6c757d;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 600;
        }

    /* === PRODUCTS GRID === */
    .products-section {
        min-height: 500px;
    }

    .section-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .results-count {
        font-size: 0.95rem;
        color: #6c757d;
    }

        .results-count strong {
            color: #2c3e50;
            font-weight: 600;
        }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 24px;
    }

    /* === PRODUCT CARD === */
    .product-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid #e9ecef;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            border-color: #e74c3c;
        }

    .product-image-container {
        position: relative;
        background: #f8f9fa;
        aspect-ratio: 1;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 24px;
        transition: transform 0.4s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .product-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #e74c3c;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        z-index: 10;
    }

        .product-badge.new {
            background: #27ae60;
        }

    .product-content {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-category-tag {
        color: #e74c3c;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .product-title {
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 12px;
        line-height: 1.4;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

        .product-title a {
            color: inherit;
            text-decoration: none;
            transition: color 0.2s;
        }

            .product-title a:hover {
                color: #e74c3c;
            }

    .product-price-section {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 16px;
    }

    .product-price {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .product-price-old {
        font-size: 1rem;
        color: #95a5a6;
        text-decoration: line-through;
    }

    .btn-add-cart {
        background: #e74c3c;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        width: 100%;
    }

        .btn-add-cart:hover:not(:disabled) {
            background: #c0392b;
            transform: translateY(-1px);
        }

        .btn-add-cart:disabled {
            background: #95a5a6;
            cursor: not-allowed;
        }

    /* === EMPTY STATE === */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: white;
        border-radius: 16px;
        border: 1px solid #e9ecef;
    }

        .empty-state i {
            font-size: 64px;
            color: #e9ecef;
            margin-bottom: 24px;
        }

        .empty-state h3 {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 12px;
        }

        .empty-state p {
            color: #6c757d;
            margin-bottom: 24px;
        }

        .empty-state .btn {
            background: #e74c3c;
            color: white;
            padding: 12px 32px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            transition: background 0.2s;
        }

            .empty-state .btn:hover {
                background: #c0392b;
            }

    /* === RESPONSIVE === */
    @@media (max-width: 991px) {
        .sidebar {
            position: static;
            margin-bottom: 30px;
        }

        .product-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        }
    }

    @@media (max-width: 576px) {
        .products-header h1 {
            font-size: 1.5rem;
        }

        .product-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 16px;
        }

        .product-content {
            padding: 16px;
        }
    }
</style>

<!-- Breadcrumb -->
<div class="breadcrumb-section">
    <div class="container">
        <div class="breadcrumb-custom">
            <a href="@Url.Action("Index", "Home")">Home</a>
            <span class="separator">/</span>
            <a href="@Url.Action("Index", "Products")">Products</a>
            @if (!string.IsNullOrEmpty(currentCategory))
            {
                <span class="separator">/</span>
                <span>@currentCategory</span>
            }
        </div>
    </div>
</div>

<!-- Header -->
<div class="products-header">
    <div class="container">
        <h1>@(string.IsNullOrEmpty(currentCategory) ? "All Products" : currentCategory)</h1>
    </div>
</div>

<!-- Main Content -->
<div class="products-container">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <div class="sidebar">
                    <div class="filter-card">
                        <h3 class="filter-title">Categories</h3>
                        <div class="category-list">
                            <a href="@Url.Action("Index", "Products")"
                               class="@(string.IsNullOrEmpty(currentCategory) ? "active" : "")">
                                <span>All Products</span>
                                <span class="count">@Model.Count()</span>
                            </a>
                            @foreach (var cat in categories)
                            {
                                var count = cat.Products?.Count(p => p.IsActive && !p.IsDeleted) ?? 0;
                                <a href="@Url.Action("Index", "Products", new { category = cat.CategoryName })"
                                   class="@(currentCategory == cat.CategoryName ? "active" : "")">
                                    <span>@cat.CategoryName</span>
                                    <span class="count">@count</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="col-lg-9">
                <div class="products-section">
                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <i class="fas fa-box-open"></i>
                            <h3>No products found</h3>
                            <p>We're stocking up! Check back soon or browse other categories.</p>
                            <a href="@Url.Action("Index", "Products")" class="btn">
                                View All Products
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="section-toolbar">
                            <div class="results-count">
                                <strong>@Model.Count()</strong> products found
                            </div>
                        </div>

                        <div class="product-grid">
                            @foreach (var product in Model)
                            {
                                var isNew = (DateTime.Now - product.CreatedAt).TotalDays < 7;
                                var hasDiscount = product.ComparePrice.HasValue && product.ComparePrice > product.Price;
                                var displayPrice = product.Price;
                                var originalPrice = hasDiscount ? product.ComparePrice : null;

                                <div class="product-card">
                                    <div class="product-image-container">
                                        @if (isNew)
                                        {
                                            <span class="product-badge new">New</span>
                                        }
                                        else if (hasDiscount)
                                        {
                                            var savings = Math.Round((originalPrice.Value - product.Price) / originalPrice.Value * 100);
                                            <span class="product-badge">-@savings%</span>
                                        }

                                        <a href="@Url.Action("Details", "Products", new { id = product.Id })">
                                            <img src="@(product.ImagePath ?? "/images/no-image.jpg")"
                                                 alt="@product.ProductName"
                                                 class="product-image"
                                                 onerror="this.src='/images/no-image.jpg'">
                                        </a>
                                    </div>

                                    <div class="product-content">
                                        <div class="product-category-tag">
                                            @(product.Category?.CategoryName ?? "General")
                                        </div>

                                        <h3 class="product-title">
                                            <a href="@Url.Action("Details", "Products", new { id = product.Id })">
                                                @product.ProductName
                                            </a>
                                        </h3>

                                        <div class="product-price-section">
                                            <span class="product-price">$@displayPrice.ToString("N2")</span>
                                            @if (originalPrice.HasValue)
                                            {
                                                <span class="product-price-old">$@originalPrice.Value.ToString("N2")</span>
                                            }
                                        </div>

                                        @if (product.StockQuantity > 0)
                                        {
                                            <button class="btn-add-cart"
                                                    data-product-id="@product.Id"
                                                    data-product-name="@product.ProductName"
                                                    data-product-price="@displayPrice"
                                                    onclick="addToCart(this)">
                                                Add to Cart
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-add-cart" disabled>
                                                Out of Stock
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function addToCart(btn) {
            const productId = btn.dataset.productId;
            const productName = btn.dataset.productName;
            const originalHtml = btn.innerHTML;

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';

            try {
                const response = await fetch('/Cart/AddToCart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ productId: parseInt(productId), quantity: 1 })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    showToast('success', `${productName} added to cart!`);

                    // Update cart badge
                    const badge = document.getElementById('cart-count');
                    if (badge) {
                        badge.textContent = result.cartCount || (parseInt(badge.textContent || '0') + 1);
                    }

                    // Success animation
                    btn.innerHTML = '<i class="fas fa-check"></i> Added!';
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }, 2000);
                } else {
                    throw new Error(result.message || 'Failed to add item');
                }
            } catch (err) {
                showToast('error', err.message || 'Network error. Please try again.');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        function showToast(type, message) {
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? '#27ae60' : '#e74c3c';
            const icon = type === 'success' ? 'check-circle' : 'exclamation-circle';

            toast.innerHTML = `
                <div style="position:fixed;top:90px;right:20px;background:${bgColor};color:white;padding:16px 24px;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.2);z-index:10000;animation:slideIn 0.3s ease;display:flex;align-items:center;gap:12px;font-weight:500;">
                    <i class="fas fa-${icon}"></i>
                    <span>${message}</span>
                </div>`;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.firstElementChild.style.animation = 'slideOut 0.3s ease forwards';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Animations
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes slideIn {
                from { transform: translateX(400px); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @@keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(400px); opacity: 0; }
            }
        `;
        document.head.appendChild(style);
    </script>
}