@model HamroGrocery.Models.ViewModels.HomePageViewModel

@{
    ViewData["Title"] = "Hamro Grocery - Fresh Indian Groceries in Sydney, NSW";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- Announcement Bar -->
@if (Model.Announcements != null && Model.Announcements.Any())
{
    <section class="announcement-bar">
        <div class="container">
            @foreach (var announcement in Model.Announcements.Take(1))
            {
                <div class="announcement-content">
                    <i class="fas fa-@(announcement.Type == HamroGrocery.Models.Entities.AnnouncementType.Info ? "info-circle" :
                                                             announcement.Type == HamroGrocery.Models.Entities.AnnouncementType.Warning ? "exclamation-triangle" :
                                                             announcement.Type == HamroGrocery.Models.Entities.AnnouncementType.Success ? "check-circle" : "times-circle")"></i>
            <span><strong>@announcement.Title:</strong> @announcement.Message</span>
            <button class="announcement-close" onclick="this.closest('.announcement-bar').remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
                }
        </div>
    </section>
}

<!-- Hero Section -->
<section class="hero-compact">
    <div class="container">
        <div class="hero-wrapper">
            <div class="hero-content">
                <h1 class="hero-title">Fresh Indian Groceries Delivered</h1>
                <p class="hero-subtitle">
                    @(Model.Statistics?.TotalProducts ?? 5000)+ authentic products • Same-day delivery across Sydney, NSW
                </p>

                <!-- Search Bar -->
                <form class="hero-search" asp-controller="Products" asp-action="Search" method="get">
                    <input type="text"
                           name="query"
                           placeholder="Search for rice, spices, dal, vegetables..."
                           autocomplete="off"
                           id="heroSearchInput">
                    <button type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </form>

                <!-- Trust Badges -->
                <div class="trust-badges">
                    <div class="trust-badge">
                        <i class="fas fa-truck-fast"></i>
                        <span>Same-Day Delivery</span>
                    </div>
                    <div class="trust-badge">
                        <i class="fas fa-shield-check"></i>
                        <span>100% Authentic</span>
                    </div>
                    <div class="trust-badge">
                        <i class="fas fa-star"></i>
                        <span>@(Model.Statistics?.TotalCustomers ?? 1000)+ Happy Customers</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Category Navigation -->
<nav class="category-nav">
    <div class="container">
        <div class="category-scroll">
            <!-- All Products Link -->
            <a href="@Url.Action("Index", "Products")" class="category-pill active">
                <i class="fas fa-th"></i> All Products
            </a>

            <!-- Dynamic Categories -->
            @if (Model.Categories != null && Model.Categories.Any())
            {
                @foreach (var category in Model.Categories.Take(12))
                {
                    <a href="@Url.Action("Index", "Products", new { category = category.CategoryName })"
                       class="category-pill"
                       title="@category.Description">
                        @GetCategoryIcon(category.CategoryName) @category.CategoryName
                    </a>
                }
            }
        </div>
    </div>
</nav>

<!-- Special Deals Section -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any(p => p.ProductSpecials != null && p.ProductSpecials.Any()))
{
    var dealsProducts = Model.FeaturedProducts.Where(p => p.ProductSpecials != null && p.ProductSpecials.Any()).Take(4).ToList();

    @if (dealsProducts.Any())
    {
        <section class="deals-section">
            <div class="container">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">🔥 Hot Deals Today</h2>
                        <p class="section-subtitle">Limited time offers - Grab them before they're gone!</p>
                    </div>
                    <div class="deals-timer">
                        <i class="fas fa-clock"></i>
                        <span>Ends in: <strong id="dealCountdown">23:45:12</strong></span>
                    </div>
                </div>

                <div class="deals-grid">
                    @foreach (var product in dealsProducts)
                    {
                        var activeSpecial = product.ProductSpecials?.FirstOrDefault();
                        var discountedPrice = product.Price;
                        var savingsPercent = 0m;

                        if (activeSpecial != null)
                        {
                            if (activeSpecial.DiscountType == HamroGrocery.Models.Entities.DiscountType.Percentage)
                            {
                                discountedPrice = product.Price * (1 - activeSpecial.DiscountValue / 100);
                                savingsPercent = activeSpecial.DiscountValue;
                            }
                            else if (activeSpecial.DiscountType == HamroGrocery.Models.Entities.DiscountType.FixedAmount)
                            {
                                discountedPrice = product.Price - activeSpecial.DiscountValue;
                                savingsPercent = (activeSpecial.DiscountValue / product.Price) * 100;
                            }
                        }

                        <div class="deal-card">
                            <div class="deal-badge">@savingsPercent.ToString("F0")% OFF</div>
                            <div class="deal-image">
                                <a href="@Url.Action("Details", "Products", new { id = product.Id })">
                                    <img src="@(product.ImagePath ?? "/images/no-image.jpg")"
                                         alt="@product.ProductName"
                                         onerror="this.src='/images/no-image.jpg'">
                                </a>
                            </div>
                            <div class="deal-content">
                                <h4>@product.ProductName</h4>
                                <div class="deal-price">
                                    <span class="price-new">$@discountedPrice.ToString("N2")</span>
                                    <span class="price-old">$@product.Price.ToString("N2")</span>
                                </div>
                                <button class="btn-deal-add"
                                        data-product-id="@product.Id"
                                        data-product-name="@product.ProductName"
                                        data-product-price="@discountedPrice"
                                        onclick="addToCart(this)">
                                    <i class="fas fa-bolt"></i> Quick Add
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}

<!-- Featured Categories -->
@if (Model.Categories != null && Model.Categories.Any())
{
    <section class="featured-categories">
        <div class="container">
            <div class="section-header">
                <div>
                    <h2 class="section-title">Shop by Category</h2>
                    <p class="section-subtitle">Explore our wide range of authentic Indian groceries</p>
                </div>
            </div>

            <div class="category-grid">
                @foreach (var category in Model.Categories.Take(6))
                {
                    <a href="@Url.Action("Index", "Products", new { category = category.CategoryName })"
                       class="category-card">
                        <div class="category-card-icon">
                            @(category.Icon ?? GetCategoryIcon(category.CategoryName))
                        </div>
                        <h4>@category.CategoryName</h4>
                        <p>@(category.Description ?? "Explore our collection")</p>
                        <div class="category-card-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Best Sellers Section -->
<section class="products-section">
    <div class="container">
        <div class="section-header">
            <div>
                <h2 class="section-title">⭐ Today's Best Sellers</h2>
                <p class="section-subtitle">Handpicked favorites from Sydney's Indian community</p>
            </div>
            <a href="@Url.Action("Index", "Products")" class="view-all-btn">
                View All <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        @if (Model.FeaturedProducts == null || !Model.FeaturedProducts.Any())
        {
            <!-- Loading Skeletons -->
            <div class="products-grid">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="product-skeleton"></div>
                }
            </div>
        }
        else
        {
            <!-- Products Grid -->
            <div class="products-grid">
                @foreach (var product in Model.FeaturedProducts.Take(8))
                {
                    var activeSpecial = product.ProductSpecials?.FirstOrDefault();
                    var discountedPrice = product.Price;
                    var savingsPercent = 0m;

                    if (activeSpecial != null)
                    {
                        if (activeSpecial.DiscountType == HamroGrocery.Models.Entities.DiscountType.Percentage)
                        {
                            discountedPrice = product.Price * (1 - activeSpecial.DiscountValue / 100);
                            savingsPercent = activeSpecial.DiscountValue;
                        }
                        else if (activeSpecial.DiscountType == HamroGrocery.Models.Entities.DiscountType.FixedAmount)
                        {
                            discountedPrice = product.Price - activeSpecial.DiscountValue;
                            savingsPercent = (activeSpecial.DiscountValue / product.Price) * 100;
                        }
                    }

                    <div class="product-card">
                        <!-- Image -->
                        <div class="product-image-wrapper">
                            <a href="@Url.Action("Details", "Products", new { id = product.Id })">
                                <img src="@(product.ImagePath ?? "/images/no-image.jpg")"
                                     alt="@product.ProductName"
                                     class="product-image"
                                     onerror="this.src='/images/no-image.jpg'">
                            </a>

                            @if (activeSpecial != null)
                            {
                                <span class="product-badge sale">
                                    @if (activeSpecial.DiscountType == HamroGrocery.Models.Entities.DiscountType.BuyOneGetOne)
                                    {
                                        <text>BOGO</text>
                                    }
                                    else if (activeSpecial.DiscountType == HamroGrocery.Models.Entities.DiscountType.BuyTwoGetOne)
                                    {
                                        <text>Buy 2 Get 1</text>
                                    }
                                    else
                                    {
                                        <text>@savingsPercent.ToString("F0")% OFF</text>
                                    }
                                </span>
                            }
                            else if ((DateTime.Now - product.CreatedAt).TotalDays < 7)
                            {
                                <span class="product-badge new">NEW</span>
                            }

                            <!-- Quick Actions -->
                            <div class="product-quick-actions">
                                <button class="quick-action-btn"
                                        title="Quick View"
                                        onclick="quickView(@product.Id)">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="quick-action-btn"
                                        title="Add to Wishlist"
                                        onclick="addToWishlist(@product.Id)">
                                    <i class="far fa-heart"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="product-content">
                            <div class="product-category">
                                @(product.Category?.CategoryName ?? "Groceries")
                            </div>

                            <h3 class="product-name">
                                <a href="@Url.Action("Details", "Products", new { id = product.Id })">
                                    @product.ProductName
                                </a>
                            </h3>

                            <div class="product-price-wrapper">
                                @if (activeSpecial != null && discountedPrice < product.Price)
                                {
                                    <span class="product-price">$@discountedPrice.ToString("N2")</span>
                                    <span class="product-price-old">$@product.Price.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="product-price">$@product.Price.ToString("N2")</span>
                                }
                            </div>

                            @if (product.StockQuantity > 0)
                            {
                                if (product.StockQuantity <= product.ReorderPoint)
                                {
                                    <div class="stock-badge low">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        Only @product.StockQuantity left
                                    </div>
                                }
                                else
                                {
                                    <div class="stock-badge in-stock">
                                        <i class="fas fa-check-circle"></i>
                                        In Stock
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="stock-badge out">
                                    <i class="fas fa-times-circle"></i>
                                    Out of Stock
                                </div>
                            }

                            <!-- Add to Cart Button -->
                            @if (product.StockQuantity > 0)
                            {
                                <button class="btn-add-to-cart"
                                        data-product-id="@product.Id"
                                        data-product-name="@product.ProductName"
                                        data-product-price="@discountedPrice"
                                        onclick="addToCart(this)">
                                    <i class="fas fa-cart-plus"></i>
                                    Add to Cart
                                </button>
                            }
                            else
                            {
                                <button class="btn-add-to-cart" disabled>
                                    <i class="fas fa-ban"></i>
                                    Out of Stock
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- View All Button -->
            <div class="text-center mt-5">
                <a href="@Url.Action("Index", "Products")" class="btn-view-all">
                    <i class="fas fa-th-large me-2"></i>
                    Browse All @(Model.Statistics?.TotalProducts ?? 5000)+ Products
                </a>
            </div>
        }
    </div>
</section>

