<!-- Newsletter Section -->
<section class="newsletter-section">
    <div class="container">
        <div class="newsletter-wrapper">
            <div class="newsletter-content">
                <div class="newsletter-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                <div>
                    <h3>Get Weekly Deals & Fresh Updates</h3>
                    <p>Subscribe to our newsletter for exclusive offers, new arrivals, and Indian recipe inspiration</p>
                </div>
            </div>
            <form class="newsletter-form" id="newsletterForm">
                <input type="email"
                       placeholder="Enter your email address"
                       required
                       id="newsletterEmail">
                <button type="submit">
                    Subscribe Now
                    <i class="fas fa-paper-plane ms-2"></i>
                </button>
            </form>
        </div>
    </div>
</section>

<!-- Features Section -->
