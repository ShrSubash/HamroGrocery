@using HamroGrocery.Models.Entities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Announcement Bar -->
    <div class="announcement-bar" id="announcementBar">
        <div class="container">
            <div class="announcement-text">
                <i class="fas fa-truck-fast"></i>
                <span><strong>Free Delivery</strong> on orders over $50 across Sydney Metro!</span>
            </div>
            <button type="button"
                    class="btn-close btn-close-white announcement-close"
                    aria-label="Close"
                    onclick="this.closest('.announcement-bar').style.display='none'">
            </button>
        </div>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg main-navbar">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-store"></i>
                <span>Hamro Grocery</span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Desktop Search -->
                <div class="d-none d-lg-flex mx-auto navbar-search-wrapper">
                    <form asp-controller="Products" asp-action="Search" class="w-100">
                        <input type="text"
                               class="navbar-search"
                               placeholder="Search for rice, spices, dal..."
                               name="query"
                               autocomplete="off"
                               id="searchInput">
                        <i class="fas fa-search navbar-search-icon"></i>
                    </form>
                    <div class="search-results-dropdown" id="searchResults"></div>
                </div>

                <!-- Nav Links -->
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Products" asp-action="Index">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>

                    <!-- Dark Mode Toggle -->
                    <li class="nav-item">
                        <button type="button" class="btn dark-mode-toggle" id="darkModeToggle" title="Toggle Dark Mode">
                            <i class="fas fa-moon"></i>
                        </button>
                    </li>
                    <!-- Cart -->
                    <li class="nav-item">
                        <a class="nav-link cart-link position-relative" asp-controller="Cart" asp-action="Index" title="View Cart">
                            <i class="fas fa-shopping-cart fa-lg"></i>
                            <span class="cart-badge" id="cartCount" style="display: none;">0</span>
                        </a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <!-- Admin Dashboard Link (if admin) -->
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-tachometer-alt me-1"></i>
                                    Dashboard
                                </a>
                            </li>
                        }

                       
                        <!-- User Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="fas fa-user-circle fa-lg"></i>
                                <span class="d-none d-xl-inline">
                                    @(User.Identity?.Name?.Split('@')[0] ?? "User")
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" asp-area="Customer"
                                       asp-controller="Account"
                                       asp-action="Profile">
                                        <i class="ri-user-3-line"></i>
                                        <span>My Account</span>
                                    </a>
                                </li>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders">
                                        <i class="fas fa-shopping-bag"></i>
                                        My Orders
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                            <i class="fas fa-shield-alt"></i>
                                            Admin Panel
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt"></i>
                                            Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm px-3" asp-area="Identity" asp-page="/Account/Login">
                                <i class="fas fa-sign-in-alt me-1"></i>
                                Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-danger btn-sm px-3" asp-area="Identity" asp-page="/Account/Register">
                                <i class="fas fa-user-plus me-1"></i>
                                Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Mobile Search (Visible only on mobile) -->
    <div class="mobile-search d-lg-none">
        <div class="container-fluid">
            <form asp-controller="Products" asp-action="Search">
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           placeholder="Search products..."
                           name="query">
                    <button class="btn btn-danger" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <div class="row g-4">
                <!-- Brand Column -->
                <div class="col-lg-4">
                    <h5 class="footer-heading">
                        <i class="fas fa-store me-2"></i>
                        Hamro Grocery
                    </h5>
                    <p class="footer-text">
                        Your trusted source for authentic Indian groceries in Sydney, NSW.
                        Fresh products delivered to your doorstep.
                    </p>
                    <div class="social-links">
                        <a href="#" class="social-link" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="WhatsApp">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Company</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>

                <!-- Support Links -->
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Support</h6>
                    <ul class="footer-links">
                        <li><a href="#">Help Center</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">Delivery Info</a></li>
                    </ul>
                </div>

                <!-- Contact Info -->
                <div class="col-lg-4">
                    <h6 class="footer-heading">Contact Us</h6>
                    <p class="footer-text">
                        <i class="fas fa-map-marker-alt me-2"></i>
                        Sydney, NSW, Australia<br>

                        <i class="fas fa-phone me-2"></i>
                        +61 (04) 1234-5678<br>

                        <i class="fas fa-envelope me-2"></i>
                        support@hamrogrocery.com.au
                    </p>
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="footer-bottom">
                <p class="mb-0">
                    &copy; @DateTime.Now.Year Hamro Grocery. All rights reserved.
                    Made with <i class="fas fa-heart text-danger"></i> in Sydney, Australia.
                </p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Layout Scripts -->
    <script>
        (function() {
            'use strict';

            // Navbar scroll effect
            window.addEventListener('scroll', function() {
                const navbar = document.querySelector('.main-navbar');
                if (navbar) {
                    navbar.classList.toggle('scrolled', window.scrollY > 20);
                }
            });

            // Dark mode toggle
            const darkModeToggle = document.getElementById('darkModeToggle');
            const isDarkMode = localStorage.getItem('darkMode') === 'enabled';

            if (isDarkMode) {
                document.body.classList.add('dark-mode');
                if (darkModeToggle) {
                    darkModeToggle.innerHTML = '<i class="fas fa-sun"></i>';
                }
            }

            if (darkModeToggle) {
                darkModeToggle.addEventListener('click', function() {
                    document.body.classList.toggle('dark-mode');
                    const isEnabled = document.body.classList.contains('dark-mode');
                    this.innerHTML = isEnabled ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
                    localStorage.setItem('darkMode', isEnabled ? 'enabled' : 'disabled');
                });
            }

            // Close search results when clicking outside
            document.addEventListener('click', function(e) {
                const searchInput = document.getElementById('searchInput');
                const searchResults = document.getElementById('searchResults');

                if (searchInput && searchResults) {
                    if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                        searchResults.classList.remove('show');
                    }
                }
            });
        })();
            async function updateCartCount() {
            try {
                const response = await fetch('/Cart/GetCartCount');
                if (response.ok) {
                    const data = await response.json();
                    const cartBadge = document.getElementById('cartCount');

                    if (data.count > 0) {
                        cartBadge.textContent = data.count;
                        cartBadge.style.display = 'inline-block';

                        // Add bounce animation on update
                        cartBadge.classList.remove('bounce');
                        void cartBadge.offsetWidth; // Trigger reflow
                        cartBadge.classList.add('bounce');
                    } else {
                        cartBadge.style.display = 'none';
                    }
                }
            } catch (error) {
                console.error('Error updating cart count:', error);
            }
        }

        // Update cart count on page load
        document.addEventListener('DOMContentLoaded', () => {
            updateCartCount();

            // Listen for cart update events (triggered by cart operations)
            window.addEventListener('cartUpdated', () => {
                updateCartCount();
            });
        });

        // Auto-refresh cart count every 30 seconds (optional)
        setInterval(updateCartCount, 30000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @Html.AntiForgeryToken()
</body>
</html>